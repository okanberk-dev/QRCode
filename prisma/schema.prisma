// Wave F (CLAUDE.md §38.B + §38.196) — mail delivery audit log.
//
// Every outbound mail (transactional + lifecycle + cron) writes a row
// the moment Resend acks the request. Row keeps the template key, the
// recipient address, the send outcome, and a tiny metadata bag for
// forensic recovery (KVKK §13 / soruşturma).
//
// Retention: 2 years. Beyond that the daily prune cron deletes rows
// (cron implementation deferred — see §21.34 lifecycle pattern). KVKK
// m.7 financial-record exception doesn't apply: this table is
// operational telemetry, not a billing receipt.
//
// PII discipline: only the recipient email is stored — no Subject, no
// HTML body, no IP. Sender helper already redacts internally; this
// table is the audit trail, not a copy of the mail itself.
model MailDeliveryLog {
  id          String   @id @default(cuid())
  // Template key from SUPPORTED_MAIL_KEYS (e.g. 'password-changed',
  // 'low-rating-alert'). Non-DB-driven render-only templates write
  // their own slug (e.g. 'contact-admin').
  template    String
  // Resend recipient address — the inbox the mail was directed to.
  recipient   String
  // 'sent' | 'failed' | 'dropped' (Resend webhook future state).
  status      String
  // Free-form forensic context (userId, restaurantId, locale, error
  // reason). String|number|null|undefined values only — no PII bodies.
  metadata    Json?
  // Owner panel locale used for the rendered copy at send time. Useful
  // for "did the recipient get TR or EN?" debugging.
  locale      String?
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([template, createdAt])
  @@index([recipient, createdAt])
  @@index([status, createdAt])
  @@map("mail_delivery_logs")
}

model AdminUser {
  id                String    @id @default(cuid())
  username          String    @unique
  passwordHash      String    @map("password_hash")
  role              String    @default("superadmin")
  restaurantId      String?   @map("restaurant_id")
  // Recovery e-mail — admin opt-in, kullanıcı profile'inden ekler. Boşsa
  // /api/admin/forgot-password kod gönderemez (UI hata mesajı verir).
  email             String?   @unique
  // Şifre sıfırlama 6-haneli numerik kod. Hash olarak (SHA-256) saklanır;
  // plaintext kod yalnız ilk gönderimde mail'e konur. 15 dakika geçerli.
  resetTokenHash    String?   @map("reset_token_hash")
  resetTokenExpiry  DateTime? @map("reset_token_expiry")
  // Brute-force gating — son 1 saat içinde N başarısız sıfırlama denemesi
  // sonrası pencere bir saat kapanır.
  resetAttempts     Int       @default(0) @map("reset_attempts")
  resetLastAttempt  DateTime? @map("reset_last_attempt")
  // Şifre değişimi zaman damgası — admin password reset / users PUT
  // password update sırasında set edilir. Auth middleware JWT iat'ı bu
  // değerle karşılaştırır; iat < passwordChangedAt → token revoke. AdminUser
  // için `UserSession` muadili tablo yok (CLAUDE.md §37.3 deferred #1 →
  // bu field ile kapatıldı), bu yüzden session staleness check'i
  // single-field ile yürür.
  passwordChangedAt DateTime? @map("password_changed_at")

  restaurant        Restaurant?             @relation(fields: [restaurantId], references: [id])
  // Stage A2 §38.94 — granular permission grants (per-resource × per-action).
  // Superadmin'ler için boş kalır (helper bypass eder); manager'lar için
  // bu satırlar cross-resource access'i açar.
  permissions       AdminPermission[]
  // Stage A4 §38.96 — admin impersonation sessions (support workflow).
  // Reverse relation; tek admin paralel session açabilir (örn. iki ayrı
  // owner için support ticket); cron 30dk sonra expire eder.
  impersonations    ImpersonationSession[]  @relation("AdminImpersonations")
  // Stage 29 §38.105 — admin in-app notification feed.
  // Cascade: AdminUser silinince per-admin notification'lar temizlenir;
  // broadcast (adminId=null) entry'ler korunur (her admin görsün diye).
  notifications     AdminNotification[]
  notificationReads AdminNotificationRead[]

  @@map("admin_users")
}

// Stage A2 §38.94 — RBAC granular permission grants. Superadmin role
// her şeye erişir (`hasPermission` helper'ı superadmin'i bypass eder).
// Manager rolündeki AdminUser'lara superadmin tarafından atanmış per-resource
// × per-action grant'lar bu tabloda durur.
//
// Resource enum'u kod tarafında `RESOURCES` const'ı (src/lib/rbac.ts) ile
// senkron tutulur — DB tarafında string olarak saklanır (yeni resource
// eklerken sadece kod güncellenir, migration gerekmez).
//
// Action enum'u: 'read' | 'write' | 'delete' (helper enforce eder; DB
// constraint yok ki future-proof — yeni action eklenirse migration gerekmez).
//
// `expiresAt` future scope: süre-sınırlı temporary access grant (örn. denetim
// için 30 gün read-only). Stage A2'de helper expiresAt'ı dikkate alır
// (geçmiş expire ise hasPermission false döner).
model AdminPermission {
  id          String    @id @default(cuid())
  adminUserId String    @map("admin_user_id")
  resource    String
  action      String
  grantedById String    @map("granted_by_id")
  grantedAt   DateTime  @default(now()) @map("granted_at")
  expiresAt   DateTime? @map("expires_at")

  adminUser AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)

  @@unique([adminUserId, resource, action])
  @@index([adminUserId])
  @@map("admin_permissions")
}

// Stage A4 §38.96 — admin impersonation session.
//
// Support workflow için kritik: superadmin (veya 'impersonation:write' permission'lı
// manager) geçici olarak owner gibi panel'e girebilir. KVKK + audit + auto-timeout
// disipline:
//   - Reason zorunlu (min 20 char) — superadmin niye girdiğini sebebiyle açıklar
//   - Auto-timeout 30dk (`endsAt`) — cron her 5dk'da bir geçen session'ları kapatır
//   - Audit log iki entry: `admin.impersonate.start` + `admin.impersonate.end`
//   - User'a anlık mail bildirimi (KVKK transparency)
//
// Cron retention: `endedAt` set olan session'lar tutulur (audit history). 2 yıllık
// retention boundary AdminAuditLog ile aynı (manual cleanup ileride).
model ImpersonationSession {
  id           String    @id @default(cuid())
  adminId      String    @map("admin_id")
  targetUserId String    @map("target_user_id")
  reason       String // Min 20 char audit context, raw stored
  startedAt    DateTime  @default(now()) @map("started_at")
  endsAt       DateTime  @map("ends_at") // Mandatory 30dk pencere
  endedAt      DateTime? @map("ended_at")
  endedReason  String?   @map("ended_reason") // 'manual' | 'timeout' | 'admin_logout'

  admin      AdminUser @relation("AdminImpersonations", fields: [adminId], references: [id], onDelete: Cascade)
  targetUser User      @relation("UserImpersonations", fields: [targetUserId], references: [id], onDelete: Cascade)

  @@index([adminId, startedAt])
  @@index([targetUserId, startedAt])
  // Active session lookup için (cron + auth check):
  @@index([endedAt, endsAt])
  @@map("impersonation_sessions")
}

// Append-only log of privileged superadmin actions (user CRUD, role
// changes, etc). Defense-in-depth on top of IDOR scoping. Querying:
// `prisma.adminAuditLog.findMany({ where: { actorId } })` for a "who
// changed what" report.
model AdminAuditLog {
  id          String   @id @default(cuid())
  // Nullable — Stage A hard-delete sets to NULL when the actor's User row is
  // permanently wiped (KVKK right-to-be-forgotten). The row survives so the
  // audit trail stays continuous, but the PII actor reference is severed.
  actorId     String?  @map("actor_id")
  actorSource String   @map("actor_source") // 'admin' | 'user'
  action      String // e.g. 'admin.users.update', 'admin.users.delete'
  targetId    String?  @map("target_id")
  payload     Json? // before/after snapshot, redacted of secrets
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([actorId, createdAt])
  @@index([action, createdAt])
  @@index([targetId, createdAt])
  @@map("admin_audit_logs")
}


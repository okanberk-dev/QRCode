generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                  String    @id @default(cuid())
  email               String    @unique
  passwordHash        String    @map("password_hash")
  name                String?
  role                String    @default("restaurant_owner")
  plan                String    @default("trial") // trial | monthly | yearly
  trialEndsAt         DateTime? @map("trial_ends_at")
  locale              String    @default("tr")
  isActive            Boolean   @default(true) @map("is_active")
  // Soft delete timestamp — set when admin "Pasifleştir" runs (isActive=false).
  // Null when active. Reactivate sets back to null. Distinct from isActive
  // so we keep the moment-of-deactivation for audit/forensics.
  deactivatedAt       DateTime? @map("deactivated_at")
  // Last time admin sent an invite / password-reset mail to this user.
  // Powers per-admin re-send rate limit on /admin/members detail page
  // (1 hour cooldown — disables the button server + client side).
  lastInvitedAt       DateTime? @map("last_invited_at")
  // Last time the trial-reminders cron sent this user a "trial ending" email.
  // Used as a 20-hour dedup so a single cron tick can't fire repeatedly and
  // 4 daily ticks (1/2/3/4 days remaining) each send exactly one mail.
  lastTrialReminderAt DateTime? @map("last_trial_reminder_at")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  restaurants Restaurant[]

  @@map("users")
}

model Restaurant {
  id                String    @id @default(cuid())
  slug              String    @unique
  name              String
  category          String    @default("Restoran")
  // Kısa açıklama (Section 1 — Genel Bilgiler). ≤280 char client+server slice.
  // Public review surface ve admin restaurant detail kartlarında gösterilir.
  description       String?   @db.Text
  // İşletme web sitesi (Section 1). new URL() validation; null → "yok".
  website           String?
  // Sosyal medya entegrasyonları (Section 3 — Faz 2). new URL() validate.
  // Boş string → null. UI'da IntegrationStatusBadge connected/not_configured.
  instagramUrl      String?   @map("instagram_url")
  facebookUrl       String?   @map("facebook_url")
  whatsappUrl       String?   @map("whatsapp_url")
  reservationUrl    String?   @map("reservation_url")
  address           String?
  phone             String?
  workingHours      String?   @map("working_hours")
  // City (Pulse 2026-04 admin AdminBusinesses table). Null until owner fills
  // it in. Free-text Turkish city name; not validated against TR-IL list yet.
  city              String?   @map("city")
  // KVKK aydınlatma metni (TEXT — uzun, @db.Text zorunlu). Doluysa admin
  // tablosunda "Tam" badge'i; boş ise "Eksik" görünür.
  kvkkText          String?   @map("kvkk_text") @db.Text
  googlePlaceId     String?   @map("google_place_id")
  googleReviewUrl   String?   @map("google_review_url")
  getirYemekUrl     String?   @map("getir_yemek_url")
  yemekSepetiUrl    String?   @map("yemek_sepeti_url")
  trendyolYemekUrl  String?   @map("trendyol_yemek_url")
  // Otel/konaklama segmenti için Tripadvisor + Airbnb URL'leri. Null =
  // henüz bağlanmadı; UI "Henüz bağlanmadı" gösterir.
  tripAdvisorUrl    String?   @map("tripadvisor_url")
  airbnbUrl         String?   @map("airbnb_url")
  // Per-platform enable flag — owner panelde toggle ile manuel kapatılabilir.
  // URL doluyken toggle off ise platform "passive" (varsayılana fallback).
  // Default true; URL boşsa UI yine "Henüz bağlanmadı" gösterir (enabled
  // = URL_var AND flag=true türetilir).
  googleEnabled       Boolean @default(true) @map("google_enabled")
  yemekSepetiEnabled  Boolean @default(true) @map("yemeksepeti_enabled")
  getirEnabled        Boolean @default(true) @map("getir_enabled")
  trendyolEnabled     Boolean @default(true) @map("trendyol_enabled")
  tripAdvisorEnabled  Boolean @default(true) @map("tripadvisor_enabled")
  airbnbEnabled       Boolean @default(true) @map("airbnb_enabled")
  // Owner's chosen fallback platform when a QR has no explicit ?platform=
  // query string. NULL → Google fallback (legacy default). Values mirror
  // Feedback.platform: google | yemeksepeti | getir | trendyol_go.
  defaultRedirectPlatform String? @map("default_redirect_platform")
  notificationEmail String?   @map("notification_email")
  primaryColor      String    @default("#1a73e8")
  isActive          Boolean   @default(true) @map("is_active")
  menuEnabled       Boolean   @default(true) @map("menu_enabled")
  menuPublished     Boolean   @default(false) @map("menu_published")
  menuLogoUrl       String?   @map("menu_logo_url") @db.Text
  menuUpdatedAt     DateTime? @map("menu_updated_at")
  menuTheme         String    @default("classic") @map("menu_theme")
  menuAccentColor   String?   @map("menu_accent_color")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  userId String? @map("user_id")
  user   User?   @relation(fields: [userId], references: [id])

  feedbacks       Feedback[]
  qrGenerations   QrGeneration[]
  adminUsers      AdminUser[]
  menuCategories  MenuCategory[]
  menuItems       MenuItem[]
  analyticsEvents MenuAnalyticsEvent[]
  brandSettings   BrandSettings?

  @@map("restaurants")
}

model QrGeneration {
  id          String   @id @default(cuid())
  qrUrl       String   @map("qr_url")
  // tableNumber is intentionally a string — restaurants use mixed labels
  // ("A1", "2-outdoor", "VIP-3") so a numeric column would force lossy
  // coercion on the operator side.
  tableNumber String?  @map("table_number")
  platform    String?  @map("platform") // google | yemeksepeti | getir | trendyol_go
  serviceType String?  @map("service_type") // dine_in | takeout | delivery
  type        String   @default("feedback") @map("type") // feedback | menu
  createdAt   DateTime @default(now()) @map("created_at")

  restaurantId String     @map("restaurant_id")
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId, createdAt])
  @@map("qr_generations")
}

model Feedback {
  id                  String  @id @default(cuid())
  rating              Int
  name                String?
  email               String?
  phone               String?
  comment             String?
  source              String?
  branch              String?
  tableNumber         String? @map("table_number")
  ipAddress           String? @map("ip_address")
  userAgent           String? @map("user_agent")
  hasKvkkConsent      Boolean @default(true) @map("has_kvkk_consent")
  hasMarketingConsent Boolean @default(false) @map("has_marketing_consent")
  platform            String? @map("platform") // google | yemeksepeti | getir | trendyol_go

  // Rich Feedback Additions
  serviceType      String? @map("service_type")
  foodRating       Int?    @map("food_rating")
  serviceRating    Int?    @map("service_rating")
  atmosphereRating Int?    @map("atmosphere_rating")

  createdAt DateTime @default(now()) @map("created_at")

  restaurantId String?     @map("restaurant_id")
  restaurant   Restaurant? @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  replies    FeedbackReply[]
  flag       FeedbackFlag?
  assignment FeedbackAssignment?
  tags       FeedbackTag[]

  @@index([restaurantId, createdAt])
  @@index([ipAddress, createdAt])
  @@map("feedback")
}

model FeedbackReply {
  id           String   @id @default(cuid())
  feedbackId   String   @map("feedback_id")
  feedback     Feedback @relation(fields: [feedbackId], references: [id], onDelete: Cascade)
  authorUserId String   @map("author_user_id")
  body         String   @db.Text
  channel      String   @default("internal") // internal | google | email
  status       String   @default("sent") // draft | sent | failed
  // Where the reply text came from. 'manual' = the operator typed it,
  // 'ai_copilot' = OpenAI Co-Pilot draft was approved, 'template_fallback'
  // = AI Co-Pilot returned a deterministic template (no key / API down).
  // Powers trial-ending mail's AI reply count and any future analytics on
  // operator vs AI-driven response throughput.
  source       String?  @default("manual")
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([feedbackId, createdAt])
  @@index([source, createdAt])
  @@map("feedback_replies")
}

model FeedbackFlag {
  id         String   @id @default(cuid())
  feedbackId String   @unique @map("feedback_id")
  feedback   Feedback @relation(fields: [feedbackId], references: [id], onDelete: Cascade)
  reason     String?
  flaggedBy  String   @map("flagged_by_user_id")
  createdAt  DateTime @default(now()) @map("created_at")

  @@map("feedback_flags")
}

model FeedbackAssignment {
  id           String   @id @default(cuid())
  feedbackId   String   @unique @map("feedback_id")
  feedback     Feedback @relation(fields: [feedbackId], references: [id], onDelete: Cascade)
  assigneeId   String   @map("assignee_user_id")
  assignedById String   @map("assigned_by_user_id")
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("feedback_assignments")
}

model FeedbackTag {
  id         String   @id @default(cuid())
  feedbackId String   @map("feedback_id")
  feedback   Feedback @relation(fields: [feedbackId], references: [id], onDelete: Cascade)
  label      String
  score      Int?
  createdAt  DateTime @default(now()) @map("created_at")

  @@unique([feedbackId, label])
  @@index([feedbackId])
  @@map("feedback_tags")
}

model AutomationRule {
  id           String   @id @default(cuid())
  userId       String   @map("user_id")
  restaurantId String?  @map("restaurant_id")
  trigger      String
  threshold    String?
  action       String
  target       String?
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@index([userId, isActive])
  @@index([userId, restaurantId])
  @@map("automation_rules")
}

model ApiKey {
  id         String    @id @default(cuid())
  userId     String    @map("user_id")
  name       String
  prefix     String
  tokenHash  String    @map("token_hash")
  scopes     String[]  @default([])
  lastUsedAt DateTime? @map("last_used_at")
  revokedAt  DateTime? @map("revoked_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@index([prefix])
  @@map("api_keys")
}

model BrandSettings {
  restaurantId String   @id @map("restaurant_id")
  // Logo & favicon — base64 data URL or http(s) URL (CLAUDE.md §3 storage).
  // @db.Text required: 1200/512px WebP base64 ~140-300 KB exceeds VARCHAR(255).
  logoUrl      String?  @map("logo_url") @db.Text
  faviconUrl   String?  @map("favicon_url") @db.Text
  // Kapak görseli (Section 2 Marka Kimliği MVP). 16:9 aspect-ratio, base64
  // data URL (≤500KB) veya http(s) URL. @db.Text zorunlu (büyük WebP base64).
  // Null → BrandIdentityCard preview'da placeholder.
  coverImageUrl String?  @map("cover_image_url") @db.Text
  // Brand palette — primary mirrors Restaurant.primaryColor; secondary &
  // accent are brand-only. Hex strings ("#0A0A0A"). Null → use defaults.
  primaryColor    String? @map("primary_color")
  secondaryColor  String? @map("secondary_color")
  accentColor     String? @map("accent_color")
  // Accent font — restricted whitelist (Space Grotesk / Inter / Manrope /
  // system). Validated server-side in /api/settings/brand PUT.
  accentFont   String?  @map("accent_font")
  // Short brand description / slogan (≤140 char). Surfaced under the
  // restaurant name on public review surface and printed QR cards.
  slogan       String?  @map("slogan")
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at")

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@map("brand_settings")
}

model GoogleIntegration {
  id            String   @id @default(cuid())
  userId        String   @unique @map("user_id")
  accessToken   String   @map("access_token")
  refreshToken  String?  @map("refresh_token")
  expiresAt     DateTime @map("expires_at")
  accountId     String?  @map("account_id")
  locationsJson Json?    @map("locations_json")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@map("google_integrations")
}

model TeamMember {
  id         String    @id @default(cuid())
  ownerId    String    @map("owner_user_id")
  email      String
  name       String?
  role       String    @default("manager") // owner | manager | staff | viewer
  locations  Json? // string[] — restaurant ids
  status     String    @default("invited") // invited | active | revoked
  lastSeenAt DateTime? @map("last_seen_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  @@unique([ownerId, email])
  @@index([ownerId, status])
  @@map("team_members")
}

model Campaign {
  id           String   @id @default(cuid())
  userId       String   @map("user_id")
  restaurantId String?  @map("restaurant_id")
  name         String
  placement    String // table | receipt | door | pack
  // count = how many physical QR pieces the operator wants printed
  // (table tents, receipts, door stickers, package inserts). Capped at
  // 10 000 in the API. NOT a usage counter.
  count        Int      @default(1)
  template     String   @default("lime") // lime | white | dark | minimal
  color        String   @default("#C6F24E")
  status       String   @default("draft") // draft | live | archived
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@index([userId, status])
  @@index([userId, restaurantId])
  @@map("campaigns")
}

model NotificationPreference {
  userId           String   @id @map("user_id")
  lowRatingEmail   Boolean  @default(true) @map("low_rating_email")
  dailyDigestEmail Boolean  @default(false) @map("daily_digest_email")
  weeklyReport     Boolean  @default(true) @map("weekly_report")
  slackWebhook     String?  @map("slack_webhook")
  updatedAt        DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("notification_preferences")
}

model AdminUser {
  id           String  @id @default(cuid())
  username     String  @unique
  passwordHash String  @map("password_hash")
  role         String  @default("superadmin")
  restaurantId String? @map("restaurant_id")
  // Recovery e-mail — admin opt-in, kullanıcı profile'inden ekler. Boşsa
  // /api/admin/forgot-password kod gönderemez (UI hata mesajı verir).
  email             String?   @unique
  // Şifre sıfırlama 6-haneli numerik kod. Hash olarak (SHA-256) saklanır;
  // plaintext kod yalnız ilk gönderimde mail'e konur. 15 dakika geçerli.
  resetTokenHash    String?   @map("reset_token_hash")
  resetTokenExpiry  DateTime? @map("reset_token_expiry")
  // Brute-force gating — son 1 saat içinde N başarısız sıfırlama denemesi
  // sonrası pencere bir saat kapanır.
  resetAttempts     Int       @default(0) @map("reset_attempts")
  resetLastAttempt  DateTime? @map("reset_last_attempt")

  restaurant Restaurant? @relation(fields: [restaurantId], references: [id])

  @@map("admin_users")
}

// Append-only log of privileged superadmin actions (user CRUD, role
// changes, etc). Defense-in-depth on top of IDOR scoping. Querying:
// `prisma.adminAuditLog.findMany({ where: { actorId } })` for a "who
// changed what" report.
model AdminAuditLog {
  id          String   @id @default(cuid())
  actorId     String   @map("actor_id")
  actorSource String   @map("actor_source") // 'admin' | 'user'
  action      String // e.g. 'admin.users.update', 'admin.users.delete'
  targetId    String?  @map("target_id")
  payload     Json? // before/after snapshot, redacted of secrets
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([actorId, createdAt])
  @@index([action, createdAt])
  @@index([targetId, createdAt])
  @@map("admin_audit_logs")
}

model Settings {
  id    String @id @default(cuid())
  key   String @unique
  value String

  @@map("settings")
}

model Announcement {
  id            String    @id @default(cuid())
  title         String
  message       String    @db.Text
  status        String    @default("draft") // draft | published | archived
  severity      String    @default("info") // info | warning | critical
  locale        String    @default("all") // all | tr | en
  priority      Int       @default(0)
  startDate     DateTime? @map("start_date")
  endDate       DateTime? @map("end_date")
  ctaText       String?   @map("cta_text")
  ctaLink       String?   @map("cta_link")
  isDismissible Boolean   @default(true) @map("is_dismissible")
  createdBy     String?   @map("created_by")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  @@index([status, startDate, endDate])
  @@map("announcements")
}

model MenuCategory {
  id           String    @id @default(cuid())
  restaurantId String    @map("restaurant_id")
  name         String
  description  String?
  sortOrder    Int       @default(0) @map("sort_order")
  isVisible    Boolean   @default(true) @map("is_visible")
  // Soft delete to mirror MenuItem.deletedAt — keeps history + survives the
  // onDelete: Restrict on items->category. Public/admin lists must filter
  // `deletedAt IS NULL`.
  deletedAt    DateTime? @map("deleted_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  items      MenuItem[]

  @@index([restaurantId, sortOrder])
  @@map("menu_categories")
}

model MenuItem {
  id           String    @id @default(cuid())
  restaurantId String    @map("restaurant_id")
  categoryId   String    @map("category_id")
  name         String
  description  String?
  priceCents   Int       @default(0) @map("price_cents")
  currency     String    @default("TRY")
  imageUrl     String?   @map("image_url") @db.Text
  badges       String[]  @default([])
  isAvailable  Boolean   @default(true) @map("is_available")
  isOutOfStock Boolean   @default(false) @map("is_out_of_stock")
  sortOrder    Int       @default(0) @map("sort_order")
  deletedAt    DateTime? @map("deleted_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  restaurant Restaurant   @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  category   MenuCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@index([restaurantId])
  @@index([categoryId, sortOrder])
  @@map("menu_items")
}

model MenuAnalyticsEvent {
  id           String   @id @default(cuid())
  restaurantId String   @map("restaurant_id")
  categoryId   String?  @map("category_id")
  productId    String?  @map("product_id")
  eventType    String   @map("event_type") // menu_view | menu_category_click | menu_product_view | menu_product_click | menu_upsell_click
  sessionId    String   @map("session_id")
  sourceType   String?  @map("source_type") // qr | direct | table | link | delivery
  metadata     Json?
  createdAt    DateTime @default(now()) @map("created_at")

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId, eventType, createdAt])
  @@index([restaurantId, categoryId, eventType, createdAt])
  @@index([restaurantId, productId, eventType, createdAt])
  @@index([restaurantId, sessionId, createdAt])
  @@index([restaurantId, sourceType, createdAt])
  @@map("menu_analytics_events")
}

model BlogPost {
  id          String   @id @default(cuid())
  slug        String
  locale      String // 'tr' or 'en'
  title       String
  description String
  content     String   @db.Text
  date        String
  readTime    String   @map("read_time")
  author      String
  coverImage  String   @map("cover_image")
  isActive    Boolean  @default(true) @map("is_active")
  // Public page view counter — fire-and-forget incremented when the post
  // renders at /[locale]/blog/[slug]. Default 0 keeps existing rows safe.
  viewCount   Int      @default(0) @map("view_count")

  // Optional public-render overrides — fall back to defaults when null.
  // Wired by BlogPostEditor "Public görünüm" panel; consumed in
  // src/app/[locale]/blog/[slug]/page.tsx.
  authorBio       String?  @map("author_bio") @db.Text
  authorRole      String?  @map("author_role")
  tags            String[] @default([]) @map("tags")
  pullQuote       String?  @map("pull_quote") @db.Text
  pullQuoteAuthor String?  @map("pull_quote_author")
  ctaTitle        String?  @map("cta_title")
  ctaSubtitle     String?  @map("cta_subtitle") @db.Text
  ctaButtonLabel  String?  @map("cta_button_label")

  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@unique([slug, locale])
  @@map("blog_posts")
}

model CaseStudy {
  id          String   @id @default(cuid())
  slug        String   @unique
  brand       String
  sector      String
  sectorEn    String?  @map("sector_en")
  location    String
  heroImage   String   @map("hero_image")
  heroTr      String   @map("hero_tr") @db.Text
  heroEn      String   @map("hero_en") @db.Text
  subtitleTr  String?  @map("subtitle_tr") @db.Text
  subtitleEn  String?  @map("subtitle_en") @db.Text
  stats       Json // [{label:{tr,en}, value}]
  highlights  Json // [{tr, en}]
  quoteTr     String?  @map("quote_tr") @db.Text
  quoteEn     String?  @map("quote_en") @db.Text
  personName  String?  @map("person_name")
  personRole  Json?    @map("person_role") // {tr, en}
  isPublished Boolean  @default(true) @map("is_published")
  publishedAt DateTime @default(now()) @map("published_at")

  @@index([isPublished, publishedAt])
  @@map("case_studies")
}

model OnboardingProgress {
  userId      String    @id @map("user_id")
  step        Int       @default(1)
  data        Json?
  completedAt DateTime? @map("completed_at")
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at")

  @@map("onboarding_progress")
}

model NewsletterSubscriber {
  id               String    @id @default(cuid())
  email            String    @unique
  locale           String    @default("tr")
  source           String?
  ip               String?
  createdAt        DateTime  @default(now()) @map("created_at")
  unsubscribedAt   DateTime? @map("unsubscribed_at")
  unsubscribeToken String?   @unique @map("unsubscribe_token")

  @@index([createdAt])
  @@map("newsletter_subscribers")
}

// Authored newsletter issues. Cron prefers an active campaign over the
// static "last 3 blog posts" fallback. `postIds` is a plain string array
// (not a relation) — six-post cap + cron-only read keeps a join table
// premature; phantom ids from deleted posts are silently skipped at send.
model NewsletterCampaign {
  id          String    @id @default(cuid())
  title       String
  intro       String    @db.Text
  postIds     String[]  @map("post_ids")
  locale      String    @default("tr") // tr | en | both
  status      String    @default("draft") // draft | scheduled | sending | sent | failed
  scheduledAt DateTime? @map("scheduled_at")
  sentAt      DateTime? @map("sent_at")
  sentCount   Int?      @map("sent_count")
  failedCount Int?      @map("failed_count")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@index([status, scheduledAt])
  @@index([createdAt])
  @@map("newsletter_campaigns")
}

// Admin-editable copy for selected mail templates (welcome, newsletter,
// trial-ending in MVP). Each (key, locale) pair holds a JSON content blob
// keyed by the inline `copy = {...}` field names. Render functions merge
// DB content over their inline default — missing fields gracefully fall
// back to code, so a partial / corrupt row never breaks send.
model MailTemplate {
  id          String   @id @default(cuid())
  key         String // e.g. 'welcome' | 'newsletter' | 'trial-ending'
  locale      String // 'tr' | 'en'
  content     Json // { eyebrow: '...', cta: '...', ... }
  // editable=false reserved for KVKK/legal copy that admins shouldn't tweak.
  // MVP: every row is editable; flag exists so Phase 2 can lock specific
  // fields without a schema migration.
  editable    Boolean  @default(true)
  updatedById String?  @map("updated_by_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  revisions MailTemplateRevision[]

  @@unique([key, locale])
  @@index([key])
  @@map("mail_templates")
}

// Phase 5 — Audit log for mail template edits. Every PATCH writes a
// snapshot row AFTER applying the change, so admins can see history
// and revert to any prior version. Soft-prune is at the application
// layer (last 50 per template) to keep the table bounded.
//
// `templateKey` + `locale` are denormalized so the audit log survives
// MailTemplate row deletion (`onDelete: SetNull`); a 'deleted' revision
// then represents "reverted to inline default" and revert can re-create
// the row from history.
model MailTemplateRevision {
  id          String        @id @default(cuid())
  templateId  String?       @map("template_id")
  template    MailTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  templateKey String        @map("template_key")
  locale      String
  // 'created' | 'updated' | 'deleted' | 'reverted'. Stored as a string
  // so we don't need a Postgres enum migration; values are validated at
  // the API write layer.
  editType    String        @map("edit_type")
  // Snapshot of the new content after the edit. For 'deleted' rows, an
  // empty object {} represents the inline-default state.
  content     Json
  editedById  String?       @map("edited_by_id")
  createdAt   DateTime      @default(now()) @map("created_at")

  @@index([templateKey, locale, createdAt])
  @@index([templateId, createdAt])
  @@map("mail_template_revisions")
}

model ROIRequest {
  id             String   @id @default(cuid())
  email          String?
  restaurantName String?  @map("restaurant_name")
  tables         Int?
  avgTicket      Decimal? @map("avg_ticket") @db.Decimal(10, 2)
  noShowRate     Float?   @map("no_show_rate")
  projection     Json?
  ip             String?
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([email, createdAt])
  @@map("roi_requests")
}

model HelpArticle {
  id          String   @id @default(cuid())
  slug        String
  locale      String   @default("tr") // tr | en
  category    String
  title       String
  excerpt     String?  @db.Text
  body        String   @db.Text
  searchTags  String[] @default([]) @map("search_tags")
  isPublished Boolean  @default(true) @map("is_published")
  order       Int      @default(0)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at")

  @@unique([slug, locale])
  @@index([locale, category, order])
  @@index([isPublished, updatedAt])
  @@map("help_articles")
}

model CareerApplication {
  id         String   @id @default(cuid())
  name       String
  email      String
  roleSlug   String?  @map("role_slug")
  message    String?  @db.Text
  portfolio  String?
  attachment String?
  locale     String   @default("tr")
  ip         String?
  status     String   @default("new")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([roleSlug, createdAt])
  @@index([status, createdAt])
  @@map("career_applications")
}

model BillingSubscription {
  userId       String    @id @map("user_id")
  plan         String    @default("trial") // trial | monthly | yearly | enterprise
  status       String    @default("active") // active | past_due | canceled
  trialEndsAt  DateTime? @map("trial_ends_at")
  renewsAt     DateTime? @map("renews_at")
  providerRef  String?   @unique @map("provider_ref")
  paymentBrand String?   @map("payment_brand")
  paymentLast4 String?   @map("payment_last4")
  // Pricing snapshot (Faz 2 — owner-readonly billing card). Manual values
  // until Iyzico provider wires real payment events. amount in major currency
  // unit (TRY default); billingCycle is informational, mirrors plan suffix.
  amount       Decimal?  @db.Decimal(10, 2)
  currency     String?   @default("TRY")
  billingCycle String?   @map("billing_cycle") // monthly | yearly
  // Billing address — invoice "Fatura Adresi" card source. Owner-readonly,
  // admin-editable (Faz 3). Free-text Turkish formatting acceptable;
  // taxNumber is VKN/TCKN (10 or 11 digits, validated server-side in admin
  // edit endpoint).
  companyName    String? @map("company_name")
  taxNumber      String? @map("tax_number")
  billingAddress String? @map("billing_address") @db.Text
  billingCity    String? @map("billing_city")
  // Free-text admin notes — visible only on admin panel; never surfaced
  // owner-side (privacy: ops may store internal context like discount reason).
  adminNotes     String? @map("admin_notes") @db.Text
  updatedAt    DateTime  @default(now()) @updatedAt @map("updated_at")

  @@map("billing_subscriptions")
}

model BillingInvoice {
  id          String   @id @default(cuid())
  userId      String   @map("user_id")
  // Human-readable invoice number (display only) — e.g. "INV-2026-04".
  // Generated server-side at create time when admin omits one. Distinct
  // from `id` (cuid) which stays as primary key for FK stability.
  invoiceNumber String?  @unique @map("invoice_number")
  amount      Decimal  @db.Decimal(10, 2)
  currency    String   @default("TRY")
  status      String   @default("paid") // paid | pending | failed | refunded
  providerRef String?  @unique @map("provider_ref")
  pdfUrl      String?  @map("pdf_url")
  // What was billed — surfaced on owner panel ("Yıllık abonelik · Mart 2026").
  description String?
  // Admin-only notes (NEVER returned via owner endpoints; analogous to
  // BillingSubscription.adminNotes privacy guard).
  adminNotes  String?  @map("admin_notes") @db.Text
  issuedAt    DateTime @default(now()) @map("issued_at")
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at")

  @@index([userId, issuedAt])
  @@map("billing_invoices")
}

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                        String    @id @default(cuid())
  email                     String    @unique
  passwordHash              String    @map("password_hash")
  name                      String?
  // Optional contact phone (collected on team-invite acceptance, §22 davet akışı).
  // Format free-form (TR `+90 5XX...` placeholder); not validated server-side
  // because mevcut validations.ts pattern minimal — admin paneli görüntüler.
  phoneNumber               String?   @map("phone_number")
  role                      String    @default("restaurant_owner") // restaurant_owner | team_member
  plan                      String    @default("trial") // trial | monthly | yearly
  trialEndsAt               DateTime? @map("trial_ends_at")
  locale                    String    @default("tr")
  isActive                  Boolean   @default(true) @map("is_active")
  // Soft delete timestamp — set when admin "Pasifleştir" runs (isActive=false).
  // Null when active. Reactivate sets back to null. Distinct from isActive
  // so we keep the moment-of-deactivation for audit/forensics.
  deactivatedAt             DateTime? @map("deactivated_at")
  // Last time admin sent an invite / password-reset mail to this user.
  // Powers per-admin re-send rate limit on /admin/members detail page
  // (1 hour cooldown — disables the button server + client side).
  lastInvitedAt             DateTime? @map("last_invited_at")
  // Last time the trial-reminders cron sent this user a "trial ending" email.
  // Used as a 20-hour dedup so a single cron tick can't fire repeatedly and
  // 4 daily ticks (1/2/3/4 days remaining) each send exactly one mail.
  lastTrialReminderAt       DateTime? @map("last_trial_reminder_at")
  // 2FA TOTP (Section 8 — Faz 3). totpSecret base32-encoded; verify edilmeden
  // önce twoFactorEnabled=false (geçici secret). Login flow `twoFactorEnabled=true`
  // ise login sonrası 6 haneli kod prompt'una zorlar.
  totpSecret                String?   @map("totp_secret")
  twoFactorEnabled          Boolean   @default(false) @map("two_factor_enabled")
  // Backup codes — bcrypt hash array (one-time use, 8 adet).
  twoFactorBackupCodes      String[]  @default([]) @map("two_factor_backup_codes")
  // Email verification (CLAUDE.md §22 davet akışı). Self-signup ve davet akışı
  // her ikisi için emailVerified=false ile başlar; verify endpoint set eder.
  // Login flow emailVerified=false ise 403 + "/auth/check-email" yönlendirir.
  // emailVerifyToken 32 byte hex unique, 24h TTL.
  emailVerified             Boolean   @default(false) @map("email_verified")
  emailVerifyToken          String?   @unique @map("email_verify_token")
  emailVerifyTokenExpiresAt DateTime? @map("email_verify_token_expires_at")
  createdAt                 DateTime  @default(now()) @map("created_at")
  updatedAt                 DateTime  @updatedAt @map("updated_at")

  restaurants Restaurant[]
  sessions    UserSession[]

  @@map("users")
}

// Section 8 — Aktif oturumlar (Faz 3). JWT login sırasında insert edilir;
// auth middleware her request'te tokenHash'i kontrol eder, revokedAt set ise 401.
// User-Agent + IP audit + "Bu cihaz" badge + "Diğer oturumlardan çıkış" akışı için.
model UserSession {
  id         String    @id @default(cuid())
  userId     String    @map("user_id")
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  // SHA-256 hash of the JWT (raw token never stored). Login sets, logout clears
  // by setting revokedAt. Auth middleware compares hash on each request.
  tokenHash  String    @unique @map("token_hash")
  userAgent  String?   @map("user_agent")
  ipAddress  String?   @map("ip_address")
  lastSeenAt DateTime  @default(now()) @map("last_seen_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  // null = active, non-null = revoked (force logout). Soft delete for audit.
  revokedAt  DateTime? @map("revoked_at")

  @@index([userId, revokedAt])
  @@map("user_sessions")
}

model Restaurant {
  id                            String    @id @default(cuid())
  slug                          String    @unique
  name                          String
  category                      String    @default("Restoran")
  // Kısa açıklama (Section 1 — Genel Bilgiler). ≤280 char client+server slice.
  // Public review surface ve admin restaurant detail kartlarında gösterilir.
  description                   String?   @db.Text
  // İşletme web sitesi (Section 1). new URL() validation; null → "yok".
  website                       String?
  // Sosyal medya entegrasyonları (Section 3 — Faz 2). new URL() validate.
  // Boş string → null. UI'da IntegrationStatusBadge connected/not_configured.
  instagramUrl                  String?   @map("instagram_url")
  facebookUrl                   String?   @map("facebook_url")
  whatsappUrl                   String?   @map("whatsapp_url")
  reservationUrl                String?   @map("reservation_url")
  // "Diğer" custom platform — owner kendi review URL'i (TheFork, OpenTable,
  // sektör-spesifik) koyabilir. CLAUDE.md §X — domain validation YOK
  // (free-form, `website` ile aynı pattern). Label opsiyonel ama UI'da
  // gösterilir; URL düzgünse domain auto-extract ile fallback (host).
  otherPlatformUrl              String?   @map("other_platform_url") @db.Text
  otherPlatformLabel            String?   @map("other_platform_label")
  otherPlatformEnabled          Boolean   @default(true) @map("other_platform_enabled")
  // Operasyonel ayarlar (Section 7 — Faz 3). "Geçici kapalı" — public /r/<slug>
  // sayfasında "Geçici olarak kapalıyız" banner tetiklemek için. closedReason
  // (≤500 char) opsiyonel; UI sebebi gösterir.
  temporarilyClosed             Boolean   @default(false) @map("temporarily_closed")
  closedReason                  String?   @map("closed_reason")
  address                       String?
  phone                         String?
  workingHours                  String?   @map("working_hours")
  // City (Pulse 2026-04 admin AdminBusinesses table). Null until owner fills
  // it in. Free-text Turkish city name; not validated against TR-IL list yet.
  city                          String?   @map("city")
  // KVKK aydınlatma metni (TEXT — uzun, @db.Text zorunlu). Doluysa admin
  // tablosunda "Tam" badge'i; boş ise "Eksik" görünür.
  kvkkText                      String?   @map("kvkk_text") @db.Text
  googlePlaceId                 String?   @map("google_place_id")
  googleReviewUrl               String?   @map("google_review_url")
  // Admin-gated Google Business Profile review management. Basic Places
  // search/linking can stay available, but fetching Google reviews, AI reply
  // drafting, and public Google reply writes require this per-restaurant flag.
  googleReviewManagementEnabled Boolean   @default(false) @map("google_review_management_enabled")

  // Google Rating Impact Tracking
  initialGoogleRating           Float?    @map("initial_google_rating")
  currentGoogleRating           Float?    @map("current_google_rating")

  getirYemekUrl                 String?   @map("getir_yemek_url")
  yemekSepetiUrl                String?   @map("yemek_sepeti_url")
  trendyolYemekUrl              String?   @map("trendyol_yemek_url")
  // Konaklama / turizm segmenti için ek platformlar. Null = henüz
  // bağlanmadı; UI "Henüz bağlanmadı" gösterir.
  tripAdvisorUrl                String?   @map("tripadvisor_url")
  airbnbUrl                     String?   @map("airbnb_url")
  bookingUrl                    String?   @map("booking_url")
  yandexUrl                     String?   @map("yandex_url")
  // Per-platform enable flag — owner panelde toggle ile manuel kapatılabilir.
  // URL doluyken toggle off ise platform "passive" (varsayılana fallback).
  // Default true; URL boşsa UI yine "Henüz bağlanmadı" gösterir (enabled
  // = URL_var AND flag=true türetilir).
  googleEnabled                 Boolean   @default(true) @map("google_enabled")
  yemekSepetiEnabled            Boolean   @default(true) @map("yemeksepeti_enabled")
  getirEnabled                  Boolean   @default(true) @map("getir_enabled")
  trendyolEnabled               Boolean   @default(true) @map("trendyol_enabled")
  tripAdvisorEnabled            Boolean   @default(true) @map("tripadvisor_enabled")
  airbnbEnabled                 Boolean   @default(true) @map("airbnb_enabled")
  bookingEnabled                Boolean   @default(true) @map("booking_enabled")
  yandexEnabled                 Boolean   @default(true) @map("yandex_enabled")
  // Owner's chosen fallback platform when a QR has no explicit ?platform=
  // query string. NULL → Google fallback (legacy default). Values mirror
  // Feedback.platform: google | yemeksepeti | getir | trendyol_go.
  defaultRedirectPlatform       String?   @map("default_redirect_platform")
  notificationEmail             String?   @map("notification_email")
  primaryColor                  String    @default("#1a73e8")
  isActive                      Boolean   @default(true) @map("is_active")
  menuEnabled                   Boolean   @default(true) @map("menu_enabled")
  menuPublished                 Boolean   @default(false) @map("menu_published")
  menuLogoUrl                   String?   @map("menu_logo_url") @db.Text
  menuUpdatedAt                 DateTime? @map("menu_updated_at")
  menuTheme                     String    @default("classic") @map("menu_theme")
  menuAccentColor               String?   @map("menu_accent_color")
  // Pulse AI auto-draft (CLAUDE.md §15). Owner opts in per-restaurant. When
  // enabled, low-rating (≤3★) feedback POSTs trigger an async draft that
  // surfaces in the inbox. Default tone seeds suggest-reply when caller does
  // not override. Auto-send is intentionally NOT supported — owner approval is
  // always required (KVKK + brand voice).
  enableAiDraft                 Boolean   @default(false) @map("enable_ai_draft")
  googleAiEnabled               Boolean   @default(true) @map("google_ai_enabled")
  aiDraftTone                   String    @default("warm") @map("ai_draft_tone") // warm | formal | apologetic
  createdAt                     DateTime  @default(now()) @map("created_at")
  updatedAt                     DateTime  @updatedAt @map("updated_at")

  userId String? @map("user_id")
  user   User?   @relation(fields: [userId], references: [id])

  feedbacks          Feedback[]
  qrGenerations      QrGeneration[]
  qrScans            QrScan[]
  embedViews         EmbedView[]
  adminUsers         AdminUser[]
  menuCategories     MenuCategory[]
  menuItems          MenuItem[]
  analyticsEvents    MenuAnalyticsEvent[]
  brandSettings      BrandSettings?
  platformLinkChecks PlatformLinkCheck[]
  platformRedirects  PlatformRedirectEvent[]
  activationState    RestaurantActivationState?

  @@map("restaurants")
}

// Platform link health check event (CLAUDE.md §19.4 + §23.7 Phase 11.23).
// Owner panel "Platform Bağlantıları" sekmesinde "Test et" butonu (manuel)
// veya gelecekteki cron (Dalga 2) bu satırı yazar. Her test bir snapshot:
// URL anlık değerini de saklar, böylece owner sonradan URL değiştirse bile
// geçmiş test sonuçları okunabilir kalır.
//
// Severity ayrı kolon değil — ok=false durumunda error mesajı + statusCode
// yeterli. UI 'son test' rozetini latestCheck.ok'a göre hex'ler.
//
// Retention: şimdilik süresiz. Cron (Dalga 2) eklendiğinde provider başına
// son N=50 kayıt tutmak yeterli olur, eski'leri prune. Şu an manuel test
// volume'i ayda restoran başına ~5-20 → uzun süre büyümez.
model PlatformLinkCheck {
  id           String     @id @default(cuid())
  restaurantId String     @map("restaurant_id")
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  // IntegrationProvider literal'ı (src/lib/integration-domains.ts). String
  // saklıyoruz — yeni provider eklerken Prisma migration yerine sadece
  // helper'a ekleme yeter.
  provider     String
  // Test edilen URL'in snapshot'ı. Owner sonradan URL değiştirse bile
  // geçmiş test'in hangi URL'e gittiği görünür kalır. @db.Text — uzun
  // tracking parametreli URL'ler için (300 char+).
  url          String     @db.Text
  ok           Boolean
  statusCode   Int?       @map("status_code")
  latencyMs    Int?       @map("latency_ms")
  // Server fetch error mesajı veya domain validation mesajı. @db.Text +
  // helper trim'liyor (max 500 char) — Vercel/Resend stack trace'ler uzun
  // olabilir.
  error        String?    @db.Text
  // 'manual' | 'cron' | 'retest_all' (CLAUDE.md §21.20 FeedbackReply.source
  // pattern). Owner UI 'manual' + 'retest_all'ı aynı gösterir, 'cron' rozeti
  // ayrı (otomatik test sonuçları farklı confidence taşır — bazı platformlar
  // bot User-Agent'ı reddeder).
  source       String     @default("manual")
  checkedAt    DateTime   @default(now()) @map("checked_at")

  @@index([restaurantId, provider, checkedAt])
  @@index([provider, checkedAt])
  @@map("platform_link_checks")
}

// Lifecycle email log (CLAUDE.md §21.34 + §23.7 Phase 11.30). Wave B —
// `qr_not_downloaded`, `first_feedback_tips`, `upgrade_suggestion`,
// `inactive_reactivation` lifecycle email'leri için idempotency tracking.
//
// Cron her gün çalışır; aynı user+type+window tek bir mail'i tekrar
// göndermesin diye log kontrol eder. Welcome + trial-ending zaten ayrı
// trigger'lara sahip (CLAUDE.md §21.6, §21.11) — burada tracked değil.
//
// Cooldown'lar (lifecycle-email-rules.ts):
//   - qr_not_downloaded:      1 kez (lifetime — log varsa skip)
//   - first_feedback_tips:    1 kez (lifetime)
//   - upgrade_suggestion:     30 gün
//   - inactive_reactivation:  30 gün
//
// userId + restaurantId opsiyonel — bazı mail'ler sadece user-level
// (inactive), bazıları restaurant-scoped (qr/feedback). En az biri set.
model LifecycleEmailLog {
  id           String   @id @default(cuid())
  userId       String?  @map("user_id")
  restaurantId String?  @map("restaurant_id")
  type         String
  sentAt       DateTime @default(now()) @map("sent_at")
  metadata     Json?

  @@index([userId, type, sentAt])
  @@index([restaurantId, type, sentAt])
  @@map("lifecycle_email_logs")
}

// Owner panel activation checklist (CLAUDE.md §19.5 + §23.7 Phase 11.29).
// Yeni restoranlar için 5-step kurulum kontrol listesi: profile / Google
// link / QR download / QR print-share / first feedback.
//
// Bu modelde sadece **manuel tracking gereken** alanlar tutulur:
//   - qrPrintedSharedAt → owner manuel "Bunu yaptım" tıklayınca (autoreport
//                          imkansız — yazıcı / fiziksel paylaşım tracking yok)
//   - dismissedAt       → owner manuel "Kapat" tıklayınca (sadece 100% complete
//                          veya meaningful progress sonrası izin verilir)
//
// Diğer 4 step **compute edilir**, storage gereksiz (CLAUDE.md §7):
//   - profile complete    → restaurant.name + category dolu
//   - google link added   → googleReviewUrl + googleEnabled + checkProviderUrl ok
//   - qr download         → mevcut QrGeneration.count > 0 (rememberFeedbackQr
//                            mevcut /qr endpoint'inde upsert yapıyor)
//   - first feedback      → Feedback.count > 0
model RestaurantActivationState {
  id                String     @id @default(cuid())
  restaurantId      String     @unique @map("restaurant_id")
  restaurant        Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  qrPrintedSharedAt DateTime?  @map("qr_printed_shared_at")
  dismissedAt       DateTime?  @map("dismissed_at")
  createdAt         DateTime   @default(now()) @map("created_at")
  updatedAt         DateTime   @updatedAt @map("updated_at")

  @@map("restaurant_activation_states")
}

// Platform redirect event (CLAUDE.md §19.4.2 + §23.7 Phase 11.24). Müşteri
// `/r/[slug]`'da yıldız verip yüksek puanlı yorum için bir platforma
// (Google/Yemeksepeti/Trendyol/...) yönlendirildiğinde fire-and-forget
// `POST /api/platform-redirect` ile kayıt edilir. Owner panel "Platform
// Yönlendirmeleri" section'ında son 7/30 gün dağılımı görünür.
//
// Tasarım kararları (CLAUDE.md §7 minimum):
//   - Server-side 302 redirect değil; client `window.location` korunur,
//     bu endpoint sadece event log. Open-redirect imkansız (target URL
//     query'de yok, restoran kaydından okunan URL).
//   - `qrCodeId` / `feedbackId` / `campaignId` field'ları YOK — public
//     review surface o anda taşımıyor (slug + table + platform yeterli
//     metadata). İhtiyaç çıktığında migration ile eklenir.
//   - `ipHash` YOK — KVKK §13.9 IP retention zaten 90 gün ham IP için
//     uygulanıyor; hash'lenmiş IP analytics için ek değer katmıyor,
//     attack surface büyütüyor.
//   - `userAgent String? @db.Text` — bot filter'ı için (gelecek owner
//     analytics segment'i). Helper 500 char trim'liyor.
model PlatformRedirectEvent {
  id           String     @id @default(cuid())
  restaurantId String     @map("restaurant_id")
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  // IntegrationProvider literal'ı (CLAUDE.md §5 platform sistem) — Feedback.platform
  // ile aynı kelime havuzu (google/yemeksepeti/getir/trendyol_go/tripadvisor/airbnb/booking/yandex).
  provider     String
  // 'qr' | 'direct' | 'table' | 'link' | 'delivery' (CLAUDE.md §13.4 menu
  // analytics source taxonomy ile aynı, drift olmasın diye).
  source       String?
  userAgent    String?    @map("user_agent") @db.Text
  createdAt    DateTime   @default(now()) @map("created_at")

  @@index([restaurantId, provider, createdAt])
  @@index([restaurantId, createdAt])
  @@map("platform_redirect_events")
}

// QR scan event (CLAUDE.md §34.x). Public review surface (`/r/[slug]`)
// load olduğunda fire-and-forget POST /api/qr-scan ile insert edilir.
// Eski "feedback count = scan proxy" varsayımının yerine gerçek tracking:
// scan-to-review conversion oranı, masa/platform breakdown, "tarayıp ayrıldı"
// boşluğu görünür olur. Session-based dedupe (30dk window) — refresh
// abuse'a karşı (CLAUDE.md §13.3 menu analytics pattern).
model QrScan {
  id           String     @id @default(cuid())
  restaurantId String     @map("restaurant_id")
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  tableNumber  String?    @map("table_number")
  platform     String?
  source       String? // 'qr' | 'direct' | 'link' | 'table' | 'delivery'
  sessionId    String?    @map("session_id")
  // KVKK §13.9 — IP 90 gün retention (cron'la anonimleştirilebilir, mevcut
  // pattern Feedback.ipAddress'le aynı).
  ipAddress    String?    @map("ip_address")
  userAgent    String?    @map("user_agent")
  createdAt    DateTime   @default(now()) @map("created_at")

  @@index([restaurantId, createdAt])
  @@index([restaurantId, tableNumber, platform, createdAt])
  @@index([restaurantId, sessionId, createdAt])
  @@map("qr_scans")
}

// Embeddable widget view event (CLAUDE.md §34.10). İşletme sahibi web
// sitesine `/embed/[slug]` iframe gömdüğünde her sayfa load fire-and-forget
// pixel + POST tracking. parentDomain referer'dan parse (full URL leak yok),
// ipAddress 90 gün retention KVKK §13.9.
model EmbedView {
  id           String     @id @default(cuid())
  restaurantId String     @map("restaurant_id")
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  parentDomain String?    @map("parent_domain")
  ipAddress    String?    @map("ip_address")
  userAgent    String?    @map("user_agent")
  createdAt    DateTime   @default(now()) @map("created_at")

  @@index([restaurantId, createdAt])
  @@index([restaurantId, parentDomain, createdAt])
  @@map("embed_views")
}

model QrGeneration {
  id          String   @id @default(cuid())
  qrUrl       String   @map("qr_url")
  // tableNumber is intentionally a string — restaurants use mixed labels
  // ("A1", "2-outdoor", "VIP-3") so a numeric column would force lossy
  // coercion on the operator side.
  tableNumber String?  @map("table_number")
  platform    String?  @map("platform") // google | yemeksepeti | getir | trendyol_go
  serviceType String?  @map("service_type") // dine_in | takeout | delivery
  type        String   @default("feedback") @map("type") // feedback | menu
  createdAt   DateTime @default(now()) @map("created_at")

  restaurantId String     @map("restaurant_id")
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId, createdAt])
  @@map("qr_generations")
}

model Feedback {
  id                  String  @id @default(cuid())
  rating              Int
  name                String?
  email               String?
  phone               String?
  comment             String?
  source              String?
  branch              String?
  tableNumber         String? @map("table_number")
  ipAddress           String? @map("ip_address")
  userAgent           String? @map("user_agent")
  hasKvkkConsent      Boolean @default(true) @map("has_kvkk_consent")
  hasMarketingConsent Boolean @default(false) @map("has_marketing_consent")
  platform            String? @map("platform") // google | yemeksepeti | getir | trendyol_go

  // Rich Feedback Additions
  serviceType      String? @map("service_type")
  foodRating       Int?    @map("food_rating")
  serviceRating    Int?    @map("service_rating")
  atmosphereRating Int?    @map("atmosphere_rating")

  createdAt DateTime @default(now()) @map("created_at")

  restaurantId String?     @map("restaurant_id")
  restaurant   Restaurant? @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  replies    FeedbackReply[]
  flag       FeedbackFlag?
  assignment FeedbackAssignment?
  tags       FeedbackTag[]
  aiDraft    FeedbackAiDraft?

  @@index([restaurantId, createdAt])
  @@index([ipAddress, createdAt])
  // Filtered analytics paths (CLAUDE.md §17 perf pass, 2026-05).
  // /api/feedback/stats and /dashboard/analytics filter by rating /
  // platform / branch in addition to (restaurantId, createdAt). Without
  // matching composite indexes, Postgres falls back to bitmap-index
  // combinations on filtered subsets — these add 30-50ms per query on
  // tables that grow with feedback volume. Adding the indexes is safe and
  // additive (no data shape change, prisma db push picks them up).
  @@index([restaurantId, rating, createdAt])
  @@index([restaurantId, platform, createdAt])
  @@index([restaurantId, branch, createdAt])
  @@map("feedback")
}

model FeedbackReply {
  id           String   @id @default(cuid())
  feedbackId   String   @map("feedback_id")
  feedback     Feedback @relation(fields: [feedbackId], references: [id], onDelete: Cascade)
  authorUserId String   @map("author_user_id")
  body         String   @db.Text
  channel      String   @default("internal") // internal | google | email
  status       String   @default("sent") // draft | sent | failed
  // Where the reply text came from. 'manual' = the operator typed it,
  // 'ai_copilot' = OpenAI Co-Pilot draft was approved, 'template_fallback'
  // = AI Co-Pilot returned a deterministic template (no key / API down).
  // Powers trial-ending mail's AI reply count and any future analytics on
  // operator vs AI-driven response throughput.
  source       String?  @default("manual")
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([feedbackId, createdAt])
  @@index([source, createdAt])
  @@map("feedback_replies")
}

// Pulse AI auto-draft (CLAUDE.md §15 / §21.8.1). Background-generated reply
// suggestion that waits in the inbox for owner approval. One pending draft
// per feedback; consumed (deleted) when the owner sends the reply.
model FeedbackAiDraft {
  id          String   @id @default(cuid())
  feedbackId  String   @unique @map("feedback_id")
  feedback    Feedback @relation(fields: [feedbackId], references: [id], onDelete: Cascade)
  body        String   @db.Text
  tone        String // warm | formal | apologetic
  source      String   @default("ai_copilot") // ai_copilot | template_fallback
  generatedAt DateTime @default(now()) @map("generated_at")
  latencyMs   Int?     @map("latency_ms")

  @@index([feedbackId])
  @@map("feedback_ai_drafts")
}

model FeedbackFlag {
  id         String   @id @default(cuid())
  feedbackId String   @unique @map("feedback_id")
  feedback   Feedback @relation(fields: [feedbackId], references: [id], onDelete: Cascade)
  reason     String?
  flaggedBy  String   @map("flagged_by_user_id")
  createdAt  DateTime @default(now()) @map("created_at")

  @@map("feedback_flags")
}

model FeedbackAssignment {
  id           String   @id @default(cuid())

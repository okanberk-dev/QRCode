generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                        String    @id @default(cuid())
  email                     String    @unique
  passwordHash              String    @map("password_hash")
  name                      String?
  // Optional contact phone (collected on team-invite acceptance, §22 davet akışı).
  // Format free-form (TR `+90 5XX...` placeholder); not validated server-side
  // because mevcut validations.ts pattern minimal — admin paneli görüntüler.
  phoneNumber               String?   @map("phone_number")
  // §38.37 — Hesabım profile genişletme. Owner'ın işletme içi rolü/pozisyonu
  // (örn. "Operasyon müdürü", "Sahip"). Free-form, max 100 char client-side.
  position                  String?
  // §38.37 — IANA timezone (örn. "Europe/Istanbul", "Europe/London"). Default
  // null → owner UI'da "—" göster, lokal browser tz fallback. Mevcut `locale`
  // field'ından farklı (locale = dil/UI, timezone = tarih/saat formatı).
  timezone                  String?
  role                      String    @default("restaurant_owner") // restaurant_owner | team_member
  plan                      String    @default("trial") // trial | monthly | yearly
  trialEndsAt               DateTime? @map("trial_ends_at")
  locale                    String    @default("tr")
  isActive                  Boolean   @default(true) @map("is_active")
  // Soft delete timestamp — set when admin "Pasifleştir" runs (isActive=false).
  // Null when active. Reactivate sets back to null. Distinct from isActive
  // so we keep the moment-of-deactivation for audit/forensics.
  deactivatedAt             DateTime? @map("deactivated_at")
  // Last time admin sent an invite / password-reset mail to this user.
  // Powers per-admin re-send rate limit on /admin/members detail page
  // (1 hour cooldown — disables the button server + client side).
  lastInvitedAt             DateTime? @map("last_invited_at")
  // Last time the trial-reminders cron sent this user a "trial ending" email.
  // Used as a 20-hour dedup so a single cron tick can't fire repeatedly and
  // 4 daily ticks (1/2/3/4 days remaining) each send exactly one mail.
  lastTrialReminderAt       DateTime? @map("last_trial_reminder_at")
  // Wave A5 (CLAUDE.md §38.A) — owner opt-out for trial-ending mails. When
  // true, the trial-reminders cron skips this user entirely (no D-3 / D-1
  // reminders). Defaults false to preserve the existing send behaviour for
  // every user that signed up before the toggle landed.
  disableTrialReminders     Boolean   @default(false) @map("disable_trial_reminders")
  // Wave B4 (CLAUDE.md §38.B) — owner-initiated soft delete with a 30-day
  // grace window (AskUserQuestion choice). `scheduledDeletionAt` is the
  // wall-clock at which the cron actually hard-deletes the row (cascade
  // chain §37.9 + financial-record anonymisation §38.0 migration
  // 20260518000000_user_hard_delete_anonymize). `deletionCancelToken` is
  // the unique token embedded in the "click to undo" link inside the
  // confirmation mail — owner can revoke the scheduled deletion any time
  // during the grace window. Both fields default null (no scheduled
  // deletion); they are cleared together on cancel OR when the cron
  // completes the wipe.
  scheduledDeletionAt       DateTime? @map("scheduled_deletion_at")
  deletionCancelToken       String?   @unique @map("deletion_cancel_token")
  // 2FA TOTP (Section 8 — Faz 3). totpSecret base32-encoded; verify edilmeden
  // önce twoFactorEnabled=false (geçici secret). Login flow `twoFactorEnabled=true`
  // ise login sonrası 6 haneli kod prompt'una zorlar.
  totpSecret                String?   @map("totp_secret")
  twoFactorEnabled          Boolean   @default(false) @map("two_factor_enabled")
  // Backup codes — bcrypt hash array (one-time use, 8 adet).
  twoFactorBackupCodes      String[]  @default([]) @map("two_factor_backup_codes")
  // Email verification (CLAUDE.md §22 davet akışı). Self-signup ve davet akışı
  // her ikisi için emailVerified=false ile başlar; verify endpoint set eder.
  // Login flow emailVerified=false ise 403 + "/auth/check-email" yönlendirir.
  // emailVerifyToken 32 byte hex unique, 24h TTL.
  emailVerified             Boolean   @default(false) @map("email_verified")
  emailVerifyToken          String?   @unique @map("email_verify_token")
  emailVerifyTokenExpiresAt DateTime? @map("email_verify_token_expires_at")
  /// reCAPTCHA Enterprise score of the last assessed sign-in (login, register, Google). Checkout gate (CLAUDE.md §44).
  lastLoginRiskScore        Float?    @map("last_login_risk_score")
  lastLoginRiskAt           DateTime? @map("last_login_risk_at")
  createdAt                 DateTime  @default(now()) @map("created_at")
  updatedAt                 DateTime  @updatedAt @map("updated_at")

  restaurants    Restaurant[]
  replyTemplates ReplyTemplate[]
  sessions       UserSession[]
  // Stage A4 §38.96 — admin impersonation reverse relation. Bir owner'a
  // birden çok admin paralel impersonation açabilir (örn. iki ayrı support
  // ticket); her biri kendi 30dk pencere'sinde expire eder.
  impersonations ImpersonationSession[] @relation("UserImpersonations")
  // Saved cards (PayNKolay card storage). Schema-only relations, no column.
  billingCustomer BillingCustomer?
  billingCards    BillingCard[]

  @@map("users")
}

// Section 8 — Aktif oturumlar (Faz 3). JWT login sırasında insert edilir;
// auth middleware her request'te tokenHash'i kontrol eder, revokedAt set ise 401.
// User-Agent + IP audit + "Bu cihaz" badge + "Diğer oturumlardan çıkış" akışı için.
model UserSession {
  id         String    @id @default(cuid())
  userId     String    @map("user_id")
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  // SHA-256 hash of the JWT (raw token never stored). Login sets, logout clears
  // by setting revokedAt. Auth middleware compares hash on each request.
  tokenHash  String    @unique @map("token_hash")
  userAgent  String?   @map("user_agent")
  ipAddress  String?   @map("ip_address")
  // Wave D (CLAUDE.md §38.195) — fuzzy device fingerprint for the
  // "new device login" detection (user choice: UA major version + IP /16).
  // First login on a given fingerprint fires the alert mail; subsequent
  // logins from the same UA-major + IP-slash-16 are silent.
  // 16-byte sha256 hex prefix (32 chars) — collision-resistant enough
  // for forensic match, short enough for an index.
  fingerprint String?  @map("fingerprint")
  lastSeenAt DateTime  @default(now()) @map("last_seen_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  // null = active, non-null = revoked (force logout). Soft delete for audit.
  revokedAt  DateTime? @map("revoked_at")

  @@index([userId, revokedAt])
  @@index([userId, fingerprint])
  @@map("user_sessions")
}

model Restaurant {
  id                            String  @id @default(cuid())
  slug                          String  @unique
  name                          String
  category                      String  @default("Restoran")
  // Kısa açıklama (Section 1 — Genel Bilgiler). ≤280 char client+server slice.
  // Public review surface ve admin restaurant detail kartlarında gösterilir.
  description                   String? @db.Text
  // İşletme web sitesi (Section 1). new URL() validation; null → "yok".
  website                       String?
  // Sosyal medya entegrasyonları (Section 3 — Faz 2). new URL() validate.
  // Boş string → null. UI'da IntegrationStatusBadge connected/not_configured.
  instagramUrl                  String? @map("instagram_url")
  facebookUrl                   String? @map("facebook_url")
  whatsappUrl                   String? @map("whatsapp_url")
  // Opt-in WhatsApp channel surfaced on `/r/[slug]` thanks step when
  // rating ≤ 3 (CLAUDE.md §19.1 — private feedback path, KVKK-clean).
  // Owner toggles via WhatsAppReviewWizard; URL must be set OR the public
  // surface silently hides the button (defensive). `whatsappReviewMessage`
  // is an optional pre-filled WhatsApp deep-link `?text=` template; null/
  // empty falls back to the locale-aware system default.
  whatsappReviewEnabled         Boolean @default(false) @map("whatsapp_review_enabled")
  whatsappReviewMessage         String? @map("whatsapp_review_message") @db.Text
  reservationUrl                String? @map("reservation_url")
  // "Diğer" custom platform — owner kendi review URL'i (TheFork, OpenTable,
  // sektör-spesifik) koyabilir. CLAUDE.md §X — domain validation YOK
  // (free-form, `website` ile aynı pattern). Label opsiyonel ama UI'da
  // gösterilir; URL düzgünse domain auto-extract ile fallback (host).
  otherPlatformUrl              String? @map("other_platform_url") @db.Text
  otherPlatformLabel            String? @map("other_platform_label")
  otherPlatformEnabled          Boolean @default(true) @map("other_platform_enabled")
  // Operasyonel ayarlar (Section 7 — Faz 3). "Geçici kapalı" — public /r/<slug>
  // sayfasında "Geçici olarak kapalıyız" banner tetiklemek için. closedReason
  // (≤500 char) opsiyonel; UI sebebi gösterir.
  temporarilyClosed             Boolean @default(false) @map("temporarily_closed")
  closedReason                  String? @map("closed_reason")
  address                       String?
  phone                         String?
  workingHours                  String? @map("working_hours")
  // City (Pulse 2026-04 admin AdminBusinesses table). Null until owner fills
  // it in. Free-text Turkish city name; not validated against TR-IL list yet.
  city                          String? @map("city")
  // KVKK aydınlatma metni (TEXT — uzun, @db.Text zorunlu). Doluysa admin
  // tablosunda "Tam" badge'i; boş ise "Eksik" görünür.
  kvkkText                      String? @map("kvkk_text") @db.Text
  googlePlaceId                 String? @map("google_place_id")
  googleReviewUrl               String? @map("google_review_url")
  // Admin-gated Google Business Profile review management. Basic Places
  // search/linking can stay available, but fetching Google reviews, AI reply
  // drafting, and public Google reply writes require this per-restaurant flag.
  googleReviewManagementEnabled Boolean @default(false) @map("google_review_management_enabled")
  // Package-ready feature entitlements. Owner-level preferences (enableAiDraft,
  // googleAiEnabled, per-platform toggles) sit under these admin-controlled
  // master switches so future paid plans can assign them automatically.
  pulseAiEnabled                Boolean @default(true) @map("pulse_ai_enabled")
  aiAnalyticsEnabled            Boolean @default(true) @map("ai_analytics_enabled")
  externalPlatformsEnabled      Boolean @default(true) @map("external_platforms_enabled")
  // Owner panel campaigns feature (CLAUDE.md §38.98). Default true for
  // backwards-compat (existing owners keep access). Admin can opt-out via
  // /admin/restaurants/[id]/feature-access PATCH or bulk feature_override.
  // Stage 30 §38.106 — admin entitlement gate. Default `false` (yeni
  // restoranlar için OFF; admin manuel olarak entitled user'ları enable
  // eder — CLAUDE.md §5.2 paterni). Mevcut row'lar Stage 30 migration ile
  // false'a çekildi; admin /admin/restaurants/[id] feature-access
  // endpoint'inden tek-tek aktif edilir.
  // DEPRECATED (CLAUDE.md §38.241): campaign mail feature removed; column
  // kept to avoid a destructive migration. Not read or written by the app.
  campaignsEnabled              Boolean @default(false) @map("campaigns_enabled")
  // Admin master switch for the owner Surveys module (create/publish +
  // public /s/[slug] submissions). Default true so existing owners keep the
  // module they already use; admin opts a restaurant out from
  // /admin/restaurants/[id] → Paket Özellikleri (CLAUDE.md §5.2 pattern).
  surveysEnabled                Boolean @default(true) @map("surveys_enabled")
  // Set when a superadmin pauses the restaurant (detail form or bulk
  // "Duraklat"). While true the owner can no longer flip `isActive` back on
  // from Settings → Durum — before this flag an admin pause lasted only until
  // the owner's next click. Cleared when the admin reactivates.
  suspendedByAdmin              Boolean @default(false) @map("suspended_by_admin")

  // Google Rating Impact Tracking
  initialGoogleRating Float? @map("initial_google_rating")
  currentGoogleRating Float? @map("current_google_rating")

  // Stage 31b §38.108 — ETK m.5 gönderici tanımlama yükümlülüğü ve
  // İYS (İleti Yönetim Sistemi) entegrasyonu için işletme kimlik bilgileri.
  // Hepsi nullable + default null (geri uyum); admin /admin/restaurants/[id]
  // panelinden veya owner Settings → Brand Identity'den doldurulur. Mail
  // template footer'larında (Stage 31c PR3) "Reklam: ..." gönderici kimliği
  // olarak kullanılır.
  // - businessIdNumber: Vergi Kimlik Numarası (VKN — tüzel kişi) veya TC
  //   Kimlik Numarası (gerçek kişi). 10–11 haneli numerik string. Public
  //   surface'lerde maskeli (***1234) gösterilir; raw değer admin/owner
  //   gözünde kalır (KVKK data minimization).
  // - mersisNumber: Mersis (Merkezi Sicil Kayıt Sistemi) no — 16 haneli
  //   tüzel kişi rejistre numarası. ETK m.5 + ekonomik faaliyet yürüten
  //   tüzel kişiler için zorunlu (KEP'in mail karşılığı paterni).
  // - physicalAddress: ETK m.5(1)(a) "iletişim bilgileri" + ihtilaf
  //   anında tüketicinin "fiziki adresi" görme hakkı (TKHK m.4). Mail
  //   footer'da "Gönderici adres: ..." satırında render edilir.
  businessIdNumber String? @map("business_id_number")
  mersisNumber     String? @map("mersis_number")
  physicalAddress  String? @map("physical_address") @db.Text

  // Owner-tanımlı hedef puan — Analytics 14-haftalık trend chart'ında dashed
  // line + delta to target hint için (CLAUDE.md §38.25 + §38.26). Null = owner
  // henüz ayarlamadı, chart fallback olarak 4.0 industry default gösterir.
  // Range 1.0–5.0 (UI client-side validate); float çünkü 4.5 gibi yarım-puan
  // hedefler tipik (örn. fine dining 4.7 hedefler).
  targetRating Float? @map("target_rating")

  getirYemekUrl           String?   @map("getir_yemek_url")
  yemekSepetiUrl          String?   @map("yemek_sepeti_url")
  trendyolYemekUrl        String?   @map("trendyol_yemek_url")
  // Konaklama / turizm segmenti için ek platformlar. Null = henüz
  // bağlanmadı; UI "Henüz bağlanmadı" gösterir.
  tripAdvisorUrl          String?   @map("tripadvisor_url")
  airbnbUrl               String?   @map("airbnb_url")
  bookingUrl              String?   @map("booking_url")
  yandexUrl               String?   @map("yandex_url")
  // §38.52 — Yelp + Foursquare yorum platformları (kullanıcı talebi, hibrit
  // taksonomi: tasarım PagePlatforms 12 platform listesinden Yelp + Foursquare
  // eklendi; Zapier/HubSpot/Mailchimp skip — review-odaklı Buaze paterniyle).
  yelpUrl                 String?   @map("yelp_url")
  foursquareUrl           String?   @map("foursquare_url")
  // Per-platform enable flag — owner panelde toggle ile manuel kapatılabilir.
  // URL doluyken toggle off ise platform "passive" (varsayılana fallback).
  // Default true; URL boşsa UI yine "Henüz bağlanmadı" gösterir (enabled
  // = URL_var AND flag=true türetilir).
  googleEnabled           Boolean   @default(true) @map("google_enabled")
  yemekSepetiEnabled      Boolean   @default(true) @map("yemeksepeti_enabled")
  getirEnabled            Boolean   @default(true) @map("getir_enabled")
  trendyolEnabled         Boolean   @default(true) @map("trendyol_enabled")
  tripAdvisorEnabled      Boolean   @default(true) @map("tripadvisor_enabled")
  airbnbEnabled           Boolean   @default(true) @map("airbnb_enabled")
  bookingEnabled          Boolean   @default(true) @map("booking_enabled")
  yandexEnabled           Boolean   @default(true) @map("yandex_enabled")
  // §38.52 — Yelp + Foursquare enable flags
  yelpEnabled             Boolean   @default(true) @map("yelp_enabled")
  foursquareEnabled       Boolean   @default(true) @map("foursquare_enabled")
  // Owner's chosen fallback platform when a QR has no explicit ?platform=
  // query string. NULL → Google fallback (legacy default). Values mirror
  // Feedback.platform: google | yemeksepeti | getir | trendyol_go.
  defaultRedirectPlatform String?   @map("default_redirect_platform")
  // Minimum yıldız — bu değer ve üstünü veren müşteriye herkese açık platform
  // bağlantısı sunulur; altındakiler önce işletmeye özel forma düşer. Owner
  // panelden 4 veya 5 seçebilir. Varsayılan 5 (yalnız 5 yıldız aktarılır).
  redirectMinRating       Int       @default(5) @map("redirect_min_rating")
  notificationEmail       String?   @map("notification_email")
  primaryColor            String    @default("#1a73e8")
  isActive                Boolean   @default(true) @map("is_active")
  menuEnabled             Boolean   @default(true) @map("menu_enabled")
  menuPublished           Boolean   @default(false) @map("menu_published")
  menuLogoUrl             String?   @map("menu_logo_url") @db.Text
  menuUpdatedAt           DateTime? @map("menu_updated_at")
  menuTheme               String    @default("classic") @map("menu_theme")
  menuAccentColor         String?   @map("menu_accent_color")
  // Menu design (2026-11): versioned JSON of enumerated choices, read with
  // readMenuDesign (src/lib/menu-design.ts). NULL = the refreshed look of menuTheme.
  menuDesign              Json?     @map("menu_design")
  // Optional menu cover: raster data URL (CLAUDE.md §3), served only via
  // /api/menu/[slug]/img/cover. The version is a content hash written with it,
  // so the public page never loads the blob to build the URL.
  menuCoverUrl            String?   @map("menu_cover_url") @db.Text
  menuCoverVersion        String?   @map("menu_cover_version")
  // Pulse AI auto-draft (CLAUDE.md §15). Owner opts in per-restaurant. When
  // enabled, low-rating (≤3★) feedback POSTs trigger an async draft that
  // surfaces in the inbox. Default tone seeds suggest-reply when caller does
  // not override. Auto-send is intentionally NOT supported — owner approval is
  // always required (KVKK + brand voice).
  enableAiDraft           Boolean   @default(false) @map("enable_ai_draft")
  googleAiEnabled         Boolean   @default(true) @map("google_ai_enabled")
  aiDraftTone             String    @default("warm") @map("ai_draft_tone") // warm | formal | apologetic
  // Google review reply settings (tone, length, address form, signature,
  // banned phrases) — CLAUDE.md §54. Read with readGoogleReplySettings(); NULL = defaults.
  googleReplySettings     Json?     @map("google_reply_settings")
  createdAt               DateTime  @default(now()) @map("created_at")
  updatedAt               DateTime  @updatedAt @map("updated_at")

  userId String? @map("user_id")
  user   User?   @relation(fields: [userId], references: [id])

  feedbacks                Feedback[]
  qrGenerations            QrGeneration[]
  qrScans                  QrScan[]
  embedViews               EmbedView[]
  adminUsers               AdminUser[]
  menuCategories           MenuCategory[]
  menuItems                MenuItem[]
  analyticsEvents          MenuAnalyticsEvent[]
  brandSettings            BrandSettings?
  platformLinkChecks       PlatformLinkCheck[]
  platformRedirects        PlatformRedirectEvent[]
  activationState          RestaurantActivationState?
  // Stage 98 — Surveys feature (CLAUDE.md §42). Each restaurant owns its
  // surveys; QR access per-survey via /s/[slug]. Cascade delete keeps
  // SurveyResponse / SurveyAnswer trees clean.
  surveys                  Survey[]
  // Denetim Merkezi (Audit Center). Owner's internal audits — hiring quizzes,
  // operational checklists, KVKK self-checks. Templates can be private to a
  // restaurant or global (restaurantId null = superadmin catalog).
  auditTemplates           AuditTemplate[]
  auditAssignments         AuditAssignment[]
  auditResponses           AuditResponse[]
  // Phase 8c+ §38.48 Wave 2 — Customers bulk action overlays.
  // Customers Feedback-derived dedupe paterni (CLAUDE.md §4.5) intact;
  // bu mini-modeller LEFT JOIN ile customer list'e overlay eder.
  customerArchives         CustomerArchive[]
  customerSegmentOverrides CustomerSegmentOverride[]
  customerEmailCampaigns   CustomerEmailCampaign[]
  customerEmailLogs        CustomerEmailLog[]
  customerCampaignTemplates CustomerCampaignTemplate[]
  // Reputation OS — health snapshot history + Google review AI draft cache.
  healthSnapshots          RestaurantHealthSnapshot[]
  googleReviewAiDrafts     GoogleReviewAiDraft[]
  googleReviewCache        GoogleReviewCache?
  googleReviews            GoogleReview[]
  googleReplyJobs          GoogleReplyJob[]

  // Stage 17 §38.87 — Hot path: getScopedRestaurantIds her dashboard
  // request'inde `prisma.restaurant.findMany({ where: { userId } })`
  // çağırıyor. FK üzerinde covering index olmadığı için Postgres
  // sequential scan yapıyordu (Supabase performance advisor uyarısı —
  // unindexed_foreign_keys: restaurants_user_id_fkey).
  @@index([userId])
  @@map("restaurants")
}

// Platform link health check event (CLAUDE.md §19.4 + §23.7 Phase 11.23).
// Owner panel "Platform Bağlantıları" sekmesinde "Test et" butonu (manuel)
// veya gelecekteki cron (Dalga 2) bu satırı yazar. Her test bir snapshot:
// URL anlık değerini de saklar, böylece owner sonradan URL değiştirse bile
// geçmiş test sonuçları okunabilir kalır.
//
// Severity ayrı kolon değil — ok=false durumunda error mesajı + statusCode
// yeterli. UI 'son test' rozetini latestCheck.ok'a göre hex'ler.
//
// Retention: şimdilik süresiz. Cron (Dalga 2) eklendiğinde provider başına
// son N=50 kayıt tutmak yeterli olur, eski'leri prune. Şu an manuel test
// volume'i ayda restoran başına ~5-20 → uzun süre büyümez.
model PlatformLinkCheck {
  id           String     @id @default(cuid())
  restaurantId String     @map("restaurant_id")
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  // IntegrationProvider literal'ı (src/lib/integration-domains.ts). String
  // saklıyoruz — yeni provider eklerken Prisma migration yerine sadece
  // helper'a ekleme yeter.
  provider     String
  // Test edilen URL'in snapshot'ı. Owner sonradan URL değiştirse bile
  // geçmiş test'in hangi URL'e gittiği görünür kalır. @db.Text — uzun
  // tracking parametreli URL'ler için (300 char+).
  url          String     @db.Text
  ok           Boolean
  statusCode   Int?       @map("status_code")
  latencyMs    Int?       @map("latency_ms")
  // Server fetch error mesajı veya domain validation mesajı. @db.Text +
  // helper trim'liyor (max 500 char) — Vercel/Resend stack trace'ler uzun
  // olabilir.
  error        String?    @db.Text
  // 'manual' | 'cron' | 'retest_all' (CLAUDE.md §21.20 FeedbackReply.source
  // pattern). Owner UI 'manual' + 'retest_all'ı aynı gösterir, 'cron' rozeti
  // ayrı (otomatik test sonuçları farklı confidence taşır — bazı platformlar
  // bot User-Agent'ı reddeder).
  source       String     @default("manual")
  checkedAt    DateTime   @default(now()) @map("checked_at")

  @@index([restaurantId, provider, checkedAt])
  @@index([provider, checkedAt])
  @@map("platform_link_checks")
}

// Lifecycle email log (CLAUDE.md §21.34 + §23.7 Phase 11.30). Wave B —
// `qr_not_downloaded`, `first_feedback_tips`, `upgrade_suggestion`,
// `inactive_reactivation` lifecycle email'leri için idempotency tracking.
//
// Cron her gün çalışır; aynı user+type+window tek bir mail'i tekrar
// göndermesin diye log kontrol eder. Welcome + trial-ending zaten ayrı
// trigger'lara sahip (CLAUDE.md §21.6, §21.11) — burada tracked değil.
//
// Cooldown'lar (lifecycle-email-rules.ts):
//   - qr_not_downloaded:      1 kez (lifetime — log varsa skip)
//   - first_feedback_tips:    1 kez (lifetime)
//   - upgrade_suggestion:     30 gün
//   - inactive_reactivation:  30 gün
//
// userId + restaurantId opsiyonel — bazı mail'ler sadece user-level
// (inactive), bazıları restaurant-scoped (qr/feedback). En az biri set.
model LifecycleEmailLog {
  id           String   @id @default(cuid())
  userId       String?  @map("user_id")
  restaurantId String?  @map("restaurant_id")
  type         String
  sentAt       DateTime @default(now()) @map("sent_at")
  metadata     Json?

  @@index([userId, type, sentAt])
  @@index([restaurantId, type, sentAt])
  @@map("lifecycle_email_logs")
}

// Owner panel activation checklist (CLAUDE.md §19.5 + §23.7 Phase 11.29).
// Yeni restoranlar için 5-step kurulum kontrol listesi: profile / Google
// link / QR download / QR print-share / first feedback.
//
// Bu modelde sadece **manuel tracking gereken** alanlar tutulur:
//   - qrPrintedSharedAt → owner manuel "Bunu yaptım" tıklayınca (autoreport
//                          imkansız — yazıcı / fiziksel paylaşım tracking yok)
//   - dismissedAt       → owner manuel "Kapat" tıklayınca (sadece 100% complete
//                          veya meaningful progress sonrası izin verilir)
//
// Diğer 4 step **compute edilir**, storage gereksiz (CLAUDE.md §7):
//   - profile complete    → restaurant.name + category dolu
//   - google link added   → googleReviewUrl + googleEnabled + checkProviderUrl ok
//   - qr download         → mevcut QrGeneration.count > 0 (rememberFeedbackQr
//                            mevcut /qr endpoint'inde upsert yapıyor)
//   - first feedback      → Feedback.count > 0
model RestaurantActivationState {
  id                String     @id @default(cuid())
  restaurantId      String     @unique @map("restaurant_id")
  restaurant        Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  qrPrintedSharedAt DateTime?  @map("qr_printed_shared_at")
  dismissedAt       DateTime?  @map("dismissed_at")
  createdAt         DateTime   @default(now()) @map("created_at")
  updatedAt         DateTime   @updatedAt @map("updated_at")

  @@map("restaurant_activation_states")
}

// Platform redirect event (CLAUDE.md §19.4.2 + §23.7 Phase 11.24). Müşteri
// `/r/[slug]`'da yıldız verip yüksek puanlı yorum için bir platforma
// (Google/Yemeksepeti/Trendyol/...) yönlendirildiğinde fire-and-forget
// `POST /api/platform-redirect` ile kayıt edilir. Owner panel "Platform
// Yönlendirmeleri" section'ında son 7/30 gün dağılımı görünür.
//
// Tasarım kararları (CLAUDE.md §7 minimum):
//   - Server-side 302 redirect değil; client `window.location` korunur,
//     bu endpoint sadece event log. Open-redirect imkansız (target URL
//     query'de yok, restoran kaydından okunan URL).
//   - `qrCodeId` / `feedbackId` / `campaignId` field'ları YOK — public
//     review surface o anda taşımıyor (slug + table + platform yeterli
//     metadata). İhtiyaç çıktığında migration ile eklenir.
//   - `ipHash` YOK — KVKK §13.9 IP retention zaten 90 gün ham IP için
//     uygulanıyor; hash'lenmiş IP analytics için ek değer katmıyor,
//     attack surface büyütüyor.
//   - `userAgent String? @db.Text` — bot filter'ı için (gelecek owner
//     analytics segment'i). Helper 500 char trim'liyor.
model PlatformRedirectEvent {
  id           String     @id @default(cuid())
  restaurantId String     @map("restaurant_id")
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  // IntegrationProvider literal'ı (CLAUDE.md §5 platform sistem) — Feedback.platform
  // ile aynı kelime havuzu (google/yemeksepeti/getir/trendyol_go/tripadvisor/airbnb/booking/yandex).
  provider     String
  // 'qr' | 'direct' | 'table' | 'link' | 'delivery' (CLAUDE.md §13.4 menu
  // analytics source taxonomy ile aynı, drift olmasın diye).
  source       String?
  userAgent    String?    @map("user_agent") @db.Text
  createdAt    DateTime   @default(now()) @map("created_at")

  @@index([restaurantId, provider, createdAt])
  @@index([restaurantId, createdAt])
  @@map("platform_redirect_events")
}

// QR scan event (CLAUDE.md §34.x). Public review surface (`/r/[slug]`)
// load olduğunda fire-and-forget POST /api/qr-scan ile insert edilir.
// Eski "feedback count = scan proxy" varsayımının yerine gerçek tracking:
// scan-to-review conversion oranı, masa/platform breakdown, "tarayıp ayrıldı"
// boşluğu görünür olur. Session-based dedupe (30dk window) — refresh
// abuse'a karşı (CLAUDE.md §13.3 menu analytics pattern).
model QrScan {
  id           String     @id @default(cuid())
  restaurantId String     @map("restaurant_id")
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  tableNumber  String?    @map("table_number")
  platform     String?
  source       String? // 'qr' | 'direct' | 'link' | 'table' | 'delivery'
  sessionId    String?    @map("session_id")
  // KVKK §13.9 — IP 90 gün retention (cron'la anonimleştirilebilir, mevcut
  // pattern Feedback.ipAddress'le aynı).
  ipAddress    String?    @map("ip_address")
  userAgent    String?    @map("user_agent")
  createdAt    DateTime   @default(now()) @map("created_at")

  @@index([restaurantId, createdAt])
  @@index([restaurantId, tableNumber, platform, createdAt])
  @@index([restaurantId, sessionId, createdAt])
  @@map("qr_scans")
}

// Embeddable widget view event (CLAUDE.md §34.10). İşletme sahibi web
// sitesine `/embed/[slug]` iframe gömdüğünde her sayfa load fire-and-forget
// pixel + POST tracking. parentDomain referer'dan parse (full URL leak yok),
// ipAddress 90 gün retention KVKK §13.9.
model EmbedView {
  id           String     @id @default(cuid())
  restaurantId String     @map("restaurant_id")
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  parentDomain String?    @map("parent_domain")
  ipAddress    String?    @map("ip_address")
  userAgent    String?    @map("user_agent")
  createdAt    DateTime   @default(now()) @map("created_at")

  @@index([restaurantId, createdAt])
  @@index([restaurantId, parentDomain, createdAt])
  @@map("embed_views")
}

model QrGeneration {
  id          String   @id @default(cuid())
  qrUrl       String   @map("qr_url")
  // tableNumber is intentionally a string — restaurants use mixed labels
  // ("A1", "2-outdoor", "VIP-3") so a numeric column would force lossy
  // coercion on the operator side.
  tableNumber String?  @map("table_number")
  platform    String?  @map("platform") // google | yemeksepeti | getir | trendyol_go
  serviceType String?  @map("service_type") // dine_in | takeout | delivery
  type        String   @default("feedback") @map("type") // feedback | menu
  // Stage 96 — custom QR colour persistence. Hex strings (`#0A0A0A` etc).
  // NULL = use platform defaults (black/white). Owner picks the colour at
  // generation time; downstream downloads honour the same pair so
  // re-rendering a saved QR stays visually identical.
  darkColor   String?  @map("dark_color")
  lightColor  String?  @map("light_color")
  // Print/share layout (`classic`, `table_tent`, `window_sticker`, …).
  // Nullable for legacy rows + cron-generated QRs; owner picks via wizard.
  // Registry source: `src/components/panel/qr/templates/registry.ts`.
  templateId  String?  @map("template_id")
  createdAt   DateTime @default(now()) @map("created_at")

  restaurantId String     @map("restaurant_id")
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId, createdAt])
  @@map("qr_generations")
}

model Feedback {
  id                  String  @id @default(cuid())
  rating              Int
  name                String?
  email               String?
  phone               String?
  comment             String?
  source              String?
  branch              String?
  tableNumber         String? @map("table_number")
  ipAddress           String? @map("ip_address")
  userAgent           String? @map("user_agent")
  hasKvkkConsent      Boolean @default(true) @map("has_kvkk_consent")
  hasMarketingConsent Boolean @default(false) @map("has_marketing_consent")
  platform            String? @map("platform") // google | yemeksepeti | getir | trendyol_go

  // Rich Feedback Additions
  serviceType      String? @map("service_type")
  foodRating       Int?    @map("food_rating")
  serviceRating    Int?    @map("service_rating")
  atmosphereRating Int?    @map("atmosphere_rating")

  // §38.130 Stage 49 — public review surface tag chip picker.
  // 10 sabit aspect (Yemek tadı / Servis hızı / Sıcaklık / Porsiyon /
  // Fiyat / Temizlik / Atmosfer / Personel ilgisi / Müzik / Bekleme).
  // String array JSON serialize edilir; whitelist server-side enforced.
  // Backward compat: nullable + default null (mevcut feedback'ler etkilenmez).
  aspectsJson Json? @map("aspects_json")

  // §38.56 — Yorumlar Inbox tab kategorileri (Okunmamış / Beklemede).
  // isRead default false: yeni feedback owner inbox'ta açana kadar
  // okunmamış sayılır. Mark-as-read explicit owner aksiyonu gerektirir.
  // isPending default false: owner manuel "Beklemede" işaretler (örn.
  // ek bilgi bekleniyor, müşteriye geri dönülecek) — Yanıtlandı/değil
  // dikotomisi ötesi state.
  isRead    Boolean @default(false) @map("is_read")
  isPending Boolean @default(false) @map("is_pending")

  createdAt DateTime @default(now()) @map("created_at")

  restaurantId String?     @map("restaurant_id")
  restaurant   Restaurant? @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  replies    FeedbackReply[]
  flag       FeedbackFlag?
  assignment FeedbackAssignment?
  tags       FeedbackTag[]
  aiDraft    FeedbackAiDraft?

  @@index([restaurantId, createdAt])
  @@index([ipAddress, createdAt])
  // Filtered analytics paths (CLAUDE.md §17 perf pass, 2026-05).
  // /api/feedback/stats and /dashboard/analytics filter by rating /
  // platform / branch in addition to (restaurantId, createdAt). Without
  // matching composite indexes, Postgres falls back to bitmap-index
  // combinations on filtered subsets — these add 30-50ms per query on
  // tables that grow with feedback volume. Adding the indexes is safe and
  // additive (no data shape change, migration deploy applies them).
  @@index([restaurantId, rating, createdAt])
  @@index([restaurantId, platform, createdAt])
  @@index([restaurantId, branch, createdAt])
  @@map("feedback")
}

model FeedbackReply {
  id           String   @id @default(cuid())
  feedbackId   String   @map("feedback_id")
  feedback     Feedback @relation(fields: [feedbackId], references: [id], onDelete: Cascade)
  authorUserId String   @map("author_user_id")
  body         String   @db.Text
  channel      String   @default("internal") // internal | google | email
  status       String   @default("sent") // draft | sent | failed
  // Where the reply text came from. 'manual' = the operator typed it,
  // 'ai_copilot' = OpenAI Co-Pilot draft was approved, 'template_fallback'
  // = AI Co-Pilot returned a deterministic template (no key / API down).
  // Powers trial-ending mail's AI reply count and any future analytics on
  // operator vs AI-driven response throughput.
  source       String?  @default("manual")
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([feedbackId, createdAt])
  @@index([source, createdAt])
  @@map("feedback_replies")
}

// Pulse AI auto-draft (CLAUDE.md §15 / §21.8.1). Background-generated reply
// suggestion that waits in the inbox for owner approval. One pending draft
// per feedback; consumed (deleted) when the owner sends the reply.
model FeedbackAiDraft {
  id          String   @id @default(cuid())
  feedbackId  String   @unique @map("feedback_id")
  feedback    Feedback @relation(fields: [feedbackId], references: [id], onDelete: Cascade)
  body        String   @db.Text
  tone        String // warm | formal | apologetic
  source      String   @default("ai_copilot") // ai_copilot | template_fallback
  generatedAt DateTime @default(now()) @map("generated_at")
  latencyMs   Int?     @map("latency_ms")

  @@index([feedbackId])
  @@map("feedback_ai_drafts")
}

// Reputation OS — Google review AI draft cache. Background cron generates
// drafts for unreplied Google reviews so owner sees a suggested reply on
// page load (no manual button needed). Unique key = (restaurantId, reviewName)
// because Google review.name is the stable Business Profile resource path
// (`accounts/<accId>/locations/<locId>/reviews/<reviewId>`). Idempotent —
// next cron run skips drafts that exist and aren't stale (generatedAt > 24h).
//
// Differs from FeedbackAiDraft in that Google reviews are not stored in our
// DB (live-fetched), so we key by external resource name instead of an
// internal feedback FK. Restaurant relation cascade keeps cache clean when
// owner deletes a restaurant.
// Public Google review showcase cache (CLAUDE.md §53). One row per business:
// the last SUCCESSFUL Business Profile reviews snapshot plus refresh state.
// Readers always get the last good snapshot; a failed refresh only moves
// `nextAttemptAt` (exponential backoff) and never clears the data.
model GoogleReviewCache {
  id               String     @id @default(cuid())
  restaurantId     String     @unique @map("restaurant_id")
  restaurant       Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  locationName     String?    @map("location_name") // accounts/{a}/locations/{l}
  averageRating    Float?     @map("average_rating")
  totalReviewCount Int        @default(0) @map("total_review_count")
  reviews          Json? // PublicGoogleReview[] (normalized, newest first)
  reviewsUrl       String?    @map("reviews_url") @db.Text
  fetchedAt        DateTime?  @map("fetched_at") // last success
  lastAttemptAt    DateTime?  @map("last_attempt_at") // refresh lease
  nextAttemptAt    DateTime?  @map("next_attempt_at")
  failureCount     Int        @default(0) @map("failure_count")
  lastErrorCode    String?    @map("last_error_code")
  createdAt        DateTime   @default(now()) @map("created_at")
  updatedAt        DateTime   @updatedAt @map("updated_at")

  @@map("google_review_caches")
}

// One Google Business Profile review of a business (CLAUDE.md §54). Filled by
// the central refresh queue (every page via nextPageToken); the reply inbox
// reads only this table. `comment` is Google's text unchanged; `originalText`
// / `translatedText` split Google's "(Translated by Google)" form for search,
// language detection and keyword analysis.
model GoogleReview {
  id               String     @id @default(cuid())
  restaurantId     String     @map("restaurant_id")
  restaurant       Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  reviewId         String     @map("review_id")
  reviewName       String     @map("review_name") @db.Text
  reviewerName     String?    @map("reviewer_name")
  reviewerPhotoUrl String?    @map("reviewer_photo_url") @db.Text
  isAnonymous      Boolean    @default(false) @map("is_anonymous")
  rating           Int? // 1..5
  comment          String?    @db.Text
  originalText     String?    @map("original_text") @db.Text
  translatedText   String?    @map("translated_text") @db.Text
  language         String?    @db.VarChar(8)
  hasText          Boolean    @default(false) @map("has_text")
  createTime       DateTime?  @map("create_time")
  updateTime       DateTime?  @map("update_time")
  hasReply         Boolean    @default(false) @map("has_reply")
  replyComment     String?    @map("reply_comment") @db.Text
  replyUpdateTime  DateTime?  @map("reply_update_time")
  lastSeenAt       DateTime   @map("last_seen_at")
  createdAt        DateTime   @default(now()) @map("created_at")
  updatedAt        DateTime   @updatedAt @map("updated_at")

  @@unique([restaurantId, reviewId])
  @@index([restaurantId, hasReply, createTime])
  @@index([restaurantId, createTime])
  @@map("google_reviews")
}

// Bulk Google reply job (CLAUDE.md §54): owner-approved replies sent one by
// one by a server queue (quota-aware, retried with backoff, idempotent).
model GoogleReplyJob {
  id           String               @id @default(cuid())
  restaurantId String               @map("restaurant_id")
  restaurant   Restaurant           @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  actorId      String               @map("actor_id")
  actorSource  String               @map("actor_source")
  status       String               @default("running") // running | paused | done
  total        Int
  leaseUntil   DateTime?            @map("lease_until")
  confirmedAt  DateTime             @map("confirmed_at")
  createdAt    DateTime             @default(now()) @map("created_at")
  updatedAt    DateTime             @updatedAt @map("updated_at")
  items        GoogleReplyJobItem[]

  @@index([restaurantId, createdAt])
  @@index([status, updatedAt])
  @@map("google_reply_jobs")
}

model GoogleReplyJobItem {
  id            String         @id @default(cuid())
  jobId         String         @map("job_id")
  job           GoogleReplyJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  reviewId      String         @map("review_id")
  comment       String         @db.Text
  status        String         @default("pending") // pending | sending | sent | failed | skipped
  attempts      Int            @default(0)
  nextAttemptAt DateTime?      @map("next_attempt_at")
  errorCode     String?        @map("error_code")
  sentAt        DateTime?      @map("sent_at")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  @@unique([jobId, reviewId])
  @@index([jobId, status])
  @@index([reviewId, status])
  @@map("google_reply_job_items")
}

model GoogleReviewAiDraft {
  id           String     @id @default(cuid())
  restaurantId String     @map("restaurant_id")
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  // Google API resource path. Unique with restaurantId to allow same review
  // across multiple restaurants (rare, but multi-tenant safety).
  reviewName   String     @map("review_name") @db.Text
  // Snapshot of the source review at draft time. Used to detect "review
  // edited / star rating changed" so cron knows to regenerate.
  rating       Int
  commentHash  String?    @map("comment_hash") // sha256 of normalized comment
  body         String     @db.Text
  tone         String // warm | formal | apologetic
  source       String     @default("ai_copilot") // ai_copilot | template_fallback
  generatedAt  DateTime   @default(now()) @map("generated_at")
  latencyMs    Int?       @map("latency_ms")

  @@unique([restaurantId, reviewName])
  @@index([restaurantId, generatedAt])
  @@map("google_review_ai_drafts")
}

// Reputation OS — Health score snapshot history (CLAUDE.md §X — Reputation
// Operating System Suite). Captures the "before vs after Buaze" picture
// owners frequently ask for + powers the monthly health report email.
//
// Snapshot fields are nullable because (a) early snapshots may not have
// Google connected yet, (b) Q&A API can return 403 (we render "—" instead
// of failing the snapshot). `kind` distinguishes initial baseline (first
// snapshot after Google OAuth) from monthly recurring snapshots.
//
// Idempotency: monthly cron skips if a snapshot for same month already
// exists. Baseline created exactly once per restaurant (kind='baseline').
model RestaurantHealthSnapshot {
  id                  String     @id @default(cuid())
  restaurantId        String     @map("restaurant_id")
  restaurant          Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  // 'baseline' | 'monthly'. Baseline = Google OAuth ilk bağlanışta. Monthly =
  // her ayın 1'inde cron.
  kind                String
  capturedAt          DateTime   @default(now()) @map("captured_at")
  // Google Business Profile metrics
  googleRating        Float?     @map("google_rating")
  googleReviewCount   Int?       @map("google_review_count")
  googleMediaCount    Int?       @map("google_media_count")
  googleUnansweredQs  Int?       @map("google_unanswered_questions")
  profileComplete    Int?       @map("profile_complete") // 0-100
  // Feedback panel metrics (internal Buaze data)
  feedbackTotal       Int?       @map("feedback_total")
  feedbackAvgRating   Float?     @map("feedback_avg_rating")
  feedbackLowRated    Int?       @map("feedback_low_rated") // 1-3★ count
  feedbackReplied     Int?       @map("feedback_replied")
  // Aggregate computed health score (0-100). Composite of profile quality
  // + responsiveness + sentiment. Stored so monthly delta is cheap.
  healthScore         Int?       @map("health_score")
  // Optional notes (cron error message, partial fetch reason)
  notes               String?    @db.Text

  @@unique([restaurantId, kind, capturedAt])
  @@index([restaurantId, capturedAt])
  @@index([restaurantId, kind])
  @@map("restaurant_health_snapshots")
}

model FeedbackFlag {
  id         String   @id @default(cuid())
  feedbackId String   @unique @map("feedback_id")
  feedback   Feedback @relation(fields: [feedbackId], references: [id], onDelete: Cascade)
  reason     String?
  flaggedBy  String   @map("flagged_by_user_id")
  createdAt  DateTime @default(now()) @map("created_at")

  @@map("feedback_flags")
}

model FeedbackAssignment {
  id           String   @id @default(cuid())
  feedbackId   String   @unique @map("feedback_id")
  feedback     Feedback @relation(fields: [feedbackId], references: [id], onDelete: Cascade)
  assigneeId   String   @map("assignee_user_id")
  assignedById String   @map("assigned_by_user_id")
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("feedback_assignments")
}

model FeedbackTag {
  id         String   @id @default(cuid())
  feedbackId String   @map("feedback_id")
  feedback   Feedback @relation(fields: [feedbackId], references: [id], onDelete: Cascade)
  label      String
  score      Int?
  createdAt  DateTime @default(now()) @map("created_at")

  @@unique([feedbackId, label])
  @@index([feedbackId])
  @@map("feedback_tags")
}

model ApiKey {
  id         String    @id @default(cuid())
  userId     String    @map("user_id")
  name       String
  prefix     String
  tokenHash  String    @map("token_hash")
  scopes     String[]  @default([])
  lastUsedAt DateTime? @map("last_used_at")
  revokedAt  DateTime? @map("revoked_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@index([prefix])
  @@map("api_keys")
}

model BrandSettings {
  restaurantId   String   @id @map("restaurant_id")
  // Logo & favicon — base64 data URL or http(s) URL (CLAUDE.md §3 storage).
  // @db.Text required: 1200/512px WebP base64 ~140-300 KB exceeds VARCHAR(255).
  logoUrl        String?  @map("logo_url") @db.Text
  faviconUrl     String?  @map("favicon_url") @db.Text
  // Kapak görseli (Section 2 Marka Kimliği MVP). 16:9 aspect-ratio, base64
  // data URL (≤500KB) veya http(s) URL. @db.Text zorunlu (büyük WebP base64).
  // Null → BrandIdentityCard preview'da placeholder.
  coverImageUrl  String?  @map("cover_image_url") @db.Text
  // Brand palette — primary mirrors Restaurant.primaryColor; secondary &
  // accent are brand-only. Hex strings ("#0A0A0A"). Null → use defaults.
  primaryColor   String?  @map("primary_color")
  secondaryColor String?  @map("secondary_color")
  accentColor    String?  @map("accent_color")
  // Accent font — restricted whitelist (Space Grotesk / Inter / Manrope /
  // system). Validated server-side in /api/settings/brand PUT.
  accentFont     String?  @map("accent_font")
  // Short brand description / slogan (≤140 char). Surfaced under the
  // restaurant name on public review surface and printed QR cards.
  slogan         String?  @map("slogan")
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at")

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@map("brand_settings")
}

model GoogleIntegration {
  id            String   @id @default(cuid())
  userId        String   @unique @map("user_id")
  accessToken   String   @map("access_token")
  refreshToken  String?  @map("refresh_token")
  expiresAt     DateTime @map("expires_at")
  accountId     String?  @map("account_id")
  locationsJson Json?    @map("locations_json")
  // OAuth client the tokens were issued for (CLAUDE.md §53). A mismatch with
  // the current GOOGLE_CLIENT_ID means the deploy moved to another Google
  // Cloud project: the connection must be redone. NULL = pre-column row.
  clientId      String?  @map("client_id")
  // Set when Google answered invalid_grant / the token was revoked, or the
  // client changed. Cleared on a fresh OAuth. Cached reviews stay visible.
  invalidatedAt DateTime? @map("invalidated_at")
  invalidReason String?  @map("invalid_reason") // revoked | client_changed
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@map("google_integrations")
}

model TeamMember {
  id                   String    @id @default(cuid())
  ownerId              String    @map("owner_user_id")
  email                String
  name                 String?
  role                 String    @default("manager") // owner | manager | staff | viewer
  locations            Json? // string[] — restaurant ids
  status               String    @default("invited") // invited | active | revoked
  lastSeenAt           DateTime? @map("last_seen_at")
  // Section 5 — Davet kabul akışı (Faz 4). Invite gönderildiğinde token üretilir
  // (32 byte hex). /accept-invite?token=... ile kullanıcı kabul edip aktive eder.
  // expiresAt 7 gün; resend yeni token üretir + expiresAt yenilenir.
  inviteToken          String?   @unique @map("invite_token")
  inviteTokenExpiresAt DateTime? @map("invite_token_expires_at")
  lastInvitedAt        DateTime? @map("last_invited_at")
  createdAt            DateTime  @default(now()) @map("created_at")


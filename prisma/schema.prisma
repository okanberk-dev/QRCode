  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at")

  @@map("onboarding_progress")
}

model NewsletterSubscriber {
  id               String    @id @default(cuid())
  email            String    @unique
  locale           String    @default("tr")
  source           String?
  ip               String?
  createdAt        DateTime  @default(now()) @map("created_at")
  unsubscribedAt   DateTime? @map("unsubscribed_at")
  unsubscribeToken String?   @unique @map("unsubscribe_token")

  @@index([createdAt])
  @@map("newsletter_subscribers")
}

// Authored newsletter issues. Cron prefers an active campaign over the
// static "last 3 blog posts" fallback. `postIds` is a plain string array
// (not a relation) — six-post cap + cron-only read keeps a join table
// premature; phantom ids from deleted posts are silently skipped at send.
model NewsletterCampaign {
  id          String    @id @default(cuid())
  title       String
  intro       String    @db.Text
  postIds     String[]  @map("post_ids")
  locale      String    @default("tr") // tr | en | both
  status      String    @default("draft") // draft | scheduled | sending | sent | failed
  scheduledAt DateTime? @map("scheduled_at")
  sentAt      DateTime? @map("sent_at")
  sentCount   Int?      @map("sent_count")
  failedCount Int?      @map("failed_count")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@index([status, scheduledAt])
  @@index([createdAt])
  @@map("newsletter_campaigns")
}

// Admin-editable copy for selected mail templates (welcome, newsletter,
// trial-ending in MVP). Each (key, locale) pair holds a JSON content blob
// keyed by the inline `copy = {...}` field names. Render functions merge
// DB content over their inline default — missing fields gracefully fall
// back to code, so a partial / corrupt row never breaks send.
model MailTemplate {
  id          String   @id @default(cuid())
  key         String // e.g. 'welcome' | 'newsletter' | 'trial-ending'
  locale      String // 'tr' | 'en'
  content     Json // { eyebrow: '...', cta: '...', ... }
  // editable=false reserved for KVKK/legal copy that admins shouldn't tweak.
  // MVP: every row is editable; flag exists so Phase 2 can lock specific
  // fields without a schema migration.
  editable    Boolean  @default(true)
  updatedById String?  @map("updated_by_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  revisions MailTemplateRevision[]

  @@unique([key, locale])
  @@index([key])
  @@map("mail_templates")
}

// Phase 5 — Audit log for mail template edits. Every PATCH writes a
// snapshot row AFTER applying the change, so admins can see history
// and revert to any prior version. Soft-prune is at the application
// layer (last 50 per template) to keep the table bounded.
//
// `templateKey` + `locale` are denormalized so the audit log survives
// MailTemplate row deletion (`onDelete: SetNull`); a 'deleted' revision
// then represents "reverted to inline default" and revert can re-create
// the row from history.
model MailTemplateRevision {
  id          String        @id @default(cuid())
  templateId  String?       @map("template_id")
  template    MailTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  templateKey String        @map("template_key")
  locale      String
  // 'created' | 'updated' | 'deleted' | 'reverted'. Stored as a string
  // so we don't need a Postgres enum migration; values are validated at
  // the API write layer.
  editType    String        @map("edit_type")
  // Snapshot of the new content after the edit. For 'deleted' rows, an
  // empty object {} represents the inline-default state.
  content     Json
  editedById  String?       @map("edited_by_id")
  createdAt   DateTime      @default(now()) @map("created_at")

  @@index([templateKey, locale, createdAt])
  @@index([templateId, createdAt])
  @@map("mail_template_revisions")
}

model ROIRequest {
  id             String   @id @default(cuid())
  email          String?
  restaurantName String?  @map("restaurant_name")
  tables         Int?
  avgTicket      Decimal? @map("avg_ticket") @db.Decimal(10, 2)
  noShowRate     Float?   @map("no_show_rate")
  projection     Json?
  ip             String?
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([email, createdAt])
  @@map("roi_requests")
}

model HelpArticle {
  id          String   @id @default(cuid())
  slug        String
  locale      String   @default("tr") // tr | en
  category    String
  title       String
  excerpt     String?  @db.Text
  body        String   @db.Text
  searchTags  String[] @default([]) @map("search_tags")
  isPublished Boolean  @default(true) @map("is_published")
  order       Int      @default(0)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at")

  @@unique([slug, locale])
  @@index([locale, category, order])
  @@index([isPublished, updatedAt])
  @@map("help_articles")
}

model CareerApplication {
  id         String   @id @default(cuid())
  name       String
  email      String
  roleSlug   String?  @map("role_slug")
  message    String?  @db.Text
  portfolio  String?
  attachment String?
  locale     String   @default("tr")
  ip         String?
  status     String   @default("new")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([roleSlug, createdAt])
  @@index([status, createdAt])
  @@map("career_applications")
}

model BillingSubscription {
  userId         String    @id @map("user_id")
  plan           String    @default("trial") // trial | monthly | yearly | enterprise
  status         String    @default("active") // active | past_due | canceled
  trialEndsAt    DateTime? @map("trial_ends_at")
  renewsAt       DateTime? @map("renews_at")
  providerRef    String?   @unique @map("provider_ref")
  paymentBrand   String?   @map("payment_brand")
  paymentLast4   String?   @map("payment_last4")
  // Pricing snapshot (Faz 2 — owner-readonly billing card). Manual values
  // until Iyzico provider wires real payment events. amount in major currency
  // unit (TRY default); billingCycle is informational, mirrors plan suffix.
  amount         Decimal?  @db.Decimal(10, 2)
  currency       String?   @default("TRY")
  billingCycle   String?   @map("billing_cycle") // monthly | yearly
  // Billing address — invoice "Fatura Adresi" card source. Owner-readonly,
  // admin-editable (Faz 3). Free-text Turkish formatting acceptable;
  // taxNumber is VKN/TCKN (10 or 11 digits, validated server-side in admin
  // edit endpoint).
  companyName    String?   @map("company_name")
  taxNumber      String?   @map("tax_number")
  billingAddress String?   @map("billing_address") @db.Text
  billingCity    String?   @map("billing_city")
  // Free-text admin notes — visible only on admin panel; never surfaced
  // owner-side (privacy: ops may store internal context like discount reason).
  adminNotes     String?   @map("admin_notes") @db.Text
  updatedAt      DateTime  @default(now()) @updatedAt @map("updated_at")

  @@map("billing_subscriptions")
}

// ──────────────────────────────────────────────────────────────────────────
// Legal documents — admin-managed CMS for KVKK, açık rıza, gizlilik,
// kullanım şartları, çerez politikası, ETK ticari ileti, platform
// kullanım sözleşmesi (CLAUDE.md §32). MailTemplate pattern'i ile aynı
// (key + locale + content + revisions) ama farklılıklar:
//
//  • İçerik HTML/markdown gibi serbest metin (Json yerine String @db.Text)
//  • Public yüze çıkar (owner + public surface'lerden okunur), her aktif
//    versiyon kullanıcı onayına bağlanır → versiyon numarası shareable
//  • Versiyon numarası 1, 2, 3 ... otomatik artar (revision count + 1)
//  • Aktif/pasif flag — bir (key, locale) için sadece TEK row, isActive
//    onay UI'ında gösterip göstermeyeceğine karar verir
//  • Her PATCH yeni LegalDocumentRevision yazar (audit + restore)
//  • Soft delete yok — admin "Sil" → row silinir, revisions kalır (audit)
// ──────────────────────────────────────────────────────────────────────────

model LegalDocument {
  id          String    @id @default(cuid())
  // Sabit slug: 'kvkk-aydinlatma' | 'acik-riza' | 'gizlilik' | 'kullanim-sartlari'
  // | 'cerez-politikasi' | 'ticari-ileti' | 'kullanim-sozlesmesi'. (key, locale)
  // composite unique — bir tür için her dilde tek aktif metin tutulur.
  key         String
  locale      String // 'tr' | 'en'
  // Kullanıcı yüzünde görünen başlık (h1 + meta title). Admin override edebilir.
  title       String
  // Ana içerik — markdown-lite (## başlıklar + paragraflar). Render
  // `renderLegalBody()` helper'ı `\n\n` ile paragraf ayırır + `## ` satırı
  // h2 olarak basar. Admin trust boundary — sadece superadmin yazar.
  content     String    @db.Text
  // Versiyon numarası — yeni revision yazılınca otomatik artar (atomik
  // upsert + max(version)+1). Onay log'larında bu sayı saklanır → kullanıcı
  // hangi versiyona onay verdiğini geriye dönük tespit edebilir.
  version     Int       @default(1)
  // Aktiflik — false ise public surface'lerde görünmez (owner panel + public
  // sayfalar `isActive: true` filtresi uygular). Admin draft tutmak için
  // false bırakabilir. Yine versiyon zinciri korunur.
  isActive    Boolean   @default(true) @map("is_active")
  // Opsiyonel açıklama — admin paneli içi notlar (kullanıcıya gösterilmez).
  description String?   @db.Text
  // Yürürlük tarihi — admin "metin X tarihinden itibaren geçerli" diyebilir.
  // Null → updatedAt kullan. Public sayfa "Yürürlük: 30 Nisan 2026" gösterir.
  effectiveAt DateTime? @map("effective_at")
  // Versiyon yazan adminin id'si — audit. Silinirse SetNull (history korunur).
  updatedById String?   @map("updated_by_id")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  revisions LegalDocumentRevision[]
  consents  LegalConsent[]

  @@unique([key, locale])
  @@index([key, isActive])
  @@map("legal_documents")
}

// Audit log of every PATCH/DELETE/REVERT. Snapshot of the content AFTER
// the edit. Soft-prune at app layer (last 50 per (key, locale)) so the
// table stays bounded. `documentKey` + `locale` denormalized — survives
// LegalDocument deletion via SetNull, mirrors MailTemplateRevision.
model LegalDocumentRevision {
  id          String         @id @default(cuid())
  documentId  String?        @map("document_id")
  document    LegalDocument? @relation(fields: [documentId], references: [id], onDelete: SetNull)
  documentKey String         @map("document_key")
  locale      String
  version     Int
  // 'created' | 'updated' | 'deleted' | 'reverted'
  editType    String         @map("edit_type")
  // Full snapshot at this version
  title       String
  content     String         @db.Text
  isActive    Boolean        @default(true) @map("is_active")
  effectiveAt DateTime?      @map("effective_at")
  editedById  String?        @map("edited_by_id")
  createdAt   DateTime       @default(now()) @map("created_at")

  @@index([documentKey, locale, createdAt])
  @@index([documentId, createdAt])
  @@map("legal_document_revisions")
}

// User / customer consent log. Captures *who* consented to *which version*
// of *which document* at *what time*. Source = where the consent was given
// (review_form | register | onboarding | api). Polymorphic actor:
//   • subjectType='user'     + subjectId=User.id    (registered owners)
//   • subjectType='feedback' + subjectId=Feedback.id (public review form)
//   • subjectType='email'    + subjectId=email      (newsletter/contact)
// Document FK denormalized via documentKey/locale/version so the log
// survives document deletion (audit). On document delete, FK SetNull.
model LegalConsent {
  id          String         @id @default(cuid())
  documentId  String?        @map("document_id")
  document    LegalDocument? @relation(fields: [documentId], references: [id], onDelete: SetNull)
  documentKey String         @map("document_key")
  locale      String
  version     Int
  subjectType String         @map("subject_type") // 'user' | 'feedback' | 'email' | 'admin'
  subjectId   String         @map("subject_id")
  // 'review_form' | 'register' | 'onboarding' | 'newsletter' | 'contact' | 'admin'
  source      String
  // True = onay verildi, false = açıkça reddedildi (admin bilgi olarak tutar).
  // Public review form'da kvkk default true (submit gate), marketing default false.
  granted     Boolean        @default(true)
  ipAddress   String?        @map("ip_address")
  userAgent   String?        @map("user_agent") @db.Text
  createdAt   DateTime       @default(now()) @map("created_at")

  @@index([documentKey, locale, createdAt])
  @@index([subjectType, subjectId, createdAt])
  @@index([documentId, createdAt])
  @@map("legal_consents")
}

// Legal placeholder variables — admin tek noktada `COMPANY_NAME = "Buaze A.Ş."`
// gibi tanımlar; tüm hukuki metinlerdeki `{{COMPANY_NAME}}` runtime'da gerçek
// değerle render edilir (CLAUDE.md §32). MailTemplate `${firstName}` placeholder
// substitution pattern'i (§21.29) ile aynı mantık.
//
//  • value boş veya satır yoksa → placeholder ham metin olarak gösterilir
//    (admin UI bunu hatırlatır; public surface "{{KEY}}" olarak basar)
//  • Sadece superadmin yazar; trust boundary admin paneli
model LegalVariable {
  // Sabit anahtar (örn. 'COMPANY_NAME', 'COMPANY_ADDRESS'). Kataloğu
  // src/lib/legal/variables.ts içinde sabittir; admin yeni anahtar ekleyemez
  // (template'lerde tanımsız placeholder'lar render edilince {{KEY}} olarak
  // basılır, sessiz fail).
  key         String   @id
  value       String   @db.Text
  // Admin paneli içi açıklama (kullanıcı yüzünde görünmez).
  description String?  @db.Text
  updatedById String?  @map("updated_by_id")
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("legal_variables")
}

model BillingInvoice {
  id            String   @id @default(cuid())
  userId        String   @map("user_id")
  // Human-readable invoice number (display only) — e.g. "INV-2026-04".
  // Generated server-side at create time when admin omits one. Distinct
  // from `id` (cuid) which stays as primary key for FK stability.
  invoiceNumber String?  @unique @map("invoice_number")
  amount        Decimal  @db.Decimal(10, 2)
  currency      String   @default("TRY")
  status        String   @default("paid") // paid | pending | failed | refunded
  providerRef   String?  @unique @map("provider_ref")
  pdfUrl        String?  @map("pdf_url")
  // What was billed — surfaced on owner panel ("Yıllık abonelik · Mart 2026").
  description   String?
  // Admin-only notes (NEVER returned via owner endpoints; analogous to
  // BillingSubscription.adminNotes privacy guard).
  adminNotes    String?  @map("admin_notes") @db.Text
  issuedAt      DateTime @default(now()) @map("issued_at")
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at")

  @@index([userId, issuedAt])
  @@map("billing_invoices")
}

// Public marketing pricing plans, fully managed from /admin/plans.
// Single row per plan with bilingual content (TR/EN columns) — admin
// edits stay in lockstep across locales without needing dual rows.
// Public render: /api/plans GET (active, ordered by sortOrder).
// isFeatured is enforced single-row at the API layer (PATCH demotes
// others when one is promoted).
model SubscriptionPlan {
  id String @id @default(cuid())

  // Bilingual display fields
  nameTr        String
  nameEn        String
  descriptionTr String @db.Text
  descriptionEn String @db.Text

  // Pricing — whole TRY / whole USD; admin UI uses int controls.
  priceTry Int    @map("price_try")
  priceUsd Int?   @map("price_usd")
  period   String @default("month") // 'month' | 'year' | 'one-time'

  // Yıllık fiyat — owner panelin ay/yıl toggle'ında gösterilen kalıcı
  // değer. Null/undefined ise frontend formula fallback kullanır
  // (aylık × 12 × 0.8 = %20 indirim). Admin elle override edebilir
  // (örn. promosyon, ezici indirim, sezonluk).
  priceYearlyTry Int? @map("price_yearly_try")
  priceYearlyUsd Int? @map("price_yearly_usd")

  // Features — JSON string array, locale-paired
  featuresTr Json @map("features_tr")
  featuresEn Json @map("features_en")

  // CTA
  buttonTextTr String @default("Başla") @map("button_text_tr")
  buttonTextEn String @default("Start") @map("button_text_en")
  buttonHref   String @default("/auth/register") @map("button_href")

  // Display
  isActive   Boolean @default(true) @map("is_active")
  isFeatured Boolean @default(false) @map("is_featured")
  sortOrder  Int     @default(0) @map("sort_order")

  // Optional discount
  discountActive  Boolean @default(false) @map("discount_active")
  discountType    String? @map("discount_type") // 'percent' | 'fixed'
  discountValue   Int?    @map("discount_value")
  discountLabelTr String? @map("discount_label_tr")
  discountLabelEn String? @map("discount_label_en")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([isActive, sortOrder])
  @@map("subscription_plans")
}

// Phase 8c+ §38.48 Wave 2 — Customer overlay mini-models.
//
// Buaze müşterileri Feedback-derived dedupe paterni (CLAUDE.md §4.5):
// `(restaurantId, COALESCE(lower(email), phone))`. Yeni Customer ana modeli
// AÇMIYORUZ — mevcut Feedback ile sync gerekmez. Onun yerine 3 mini-model
// owner panel customer list'ine LEFT JOIN ile overlay eder:
//   - CustomerArchive: soft-delete (list'ten gizle, geri alınabilir)
//   - CustomerSegmentOverride: manuel segment ataması (derived'i replace)
//   - CustomerEmailCampaign + CustomerEmailLog: bulk send audit + dedupe
//
// IDOR: tüm 4 model `restaurantId` taşır; cascade delete restoran silindiğinde.
// Owner-scope `getScopedRestaurantIds` ile filter (CLAUDE.md §4).

model CustomerArchive {
  id           String     @id @default(cuid())
  restaurantId String     @map("restaurant_id")
  contactKey   String     @map("contact_key") // lower(email) || phone
  archivedAt   DateTime   @default(now()) @map("archived_at")
  archivedById String?    @map("archived_by_id") // nullable: actor sometimes is admin
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@unique([restaurantId, contactKey])
  @@index([restaurantId, archivedAt])
  @@map("customer_archives")
}

model CustomerSegmentOverride {
  id            String     @id @default(cuid())
  restaurantId  String     @map("restaurant_id")
  contactKey    String     @map("contact_key")
  manualSegment String     @map("manual_segment") // 'vip' | 'loyal' | 'new' | 'risk' | 'churned'
  setById       String?    @map("set_by_id")
  setAt         DateTime   @default(now()) @map("set_at")
  restaurant    Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@unique([restaurantId, contactKey])
  @@index([restaurantId, setAt])
  @@map("customer_segment_overrides")
}

model CustomerEmailCampaign {
  id             String             @id @default(cuid())
  restaurantId   String             @map("restaurant_id")
  subject        String
  body           String             @db.Text
  recipientCount Int                @default(0) @map("recipient_count")
  sentCount      Int                @default(0) @map("sent_count")
  failedCount    Int                @default(0) @map("failed_count")
  // Stage 29 §38.105 — moderation-aware status enum (string field, Zod
  // VALID_STATUSES intact). Owner submit eder → pending_approval; admin
  // approve eder → approved → sending → sent (failed). Reject eder →
  // rejected (terminal, owner revize edip yeniden draft yapabilir).
  status         String             @default("draft") // 'draft' | 'pending_approval' | 'approved' | 'rejected' | 'sending' | 'sent' | 'failed'
  scheduledAt    DateTime?          @map("scheduled_at")
  sentAt         DateTime?          @map("sent_at")
  // Stage 29 §38.105 — admin moderation timeline + reviewer note.
  // Hepsi nullable + default null → backward compat (eski rows etkilenmez).
  // submittedAt: owner draft'tan submit ettiği an (status='pending_approval')
  // approvedAt + approvedById: admin onay anı + admin user id
  // rejectedAt + rejectedById + reviewerNote: admin red anı + gerekçe (forensic
  // audit, min 20 char endpoint zorunlu — CLAUDE.md §38.96 paterni)
  submittedAt    DateTime?          @map("submitted_at")
  approvedById   String?            @map("approved_by_id")
  approvedAt     DateTime?          @map("approved_at")
  rejectedById   String?            @map("rejected_by_id")
  rejectedAt     DateTime?          @map("rejected_at")
  reviewerNote   String?            @map("reviewer_note") @db.Text
  // Stage 31b §38.108 — İYS (İleti Yönetim Sistemi) tracking placeholder.
  // Türkiye'de ticari elektronik ileti gönderen her gerçek/tüzel kişi
  // İYS'ye kayıtlı olmak ve gönderim öncesi alıcının izin durumunu sorgulamak
  // zorunda (ETK m.6 + İYS Yönetmeliği). Operatör İYS API credentials
  // sağladığında `src/lib/legal/iys.ts:reportToIys` helper'ı bu alanları
  // doldurur. Şu an placeholder: null kalır, mail footer'da `—` render
  // edilir (Stage 31c PR3 mail template footer enrichment).
  // - iysId: İYS gönderim takip ID (UUID) — alıcı ihtilaf çıkarırsa
  //   "izin sorgulanmıştı" kanıtı olarak kullanılır.
  // - iysChannelCode: 'E_MARKETING' | 'SMS' | 'CALL' (İYS kanonik
  //   kanal kodları, mevcut akışta hep 'E_MARKETING').
  iysId          String?            @map("iys_id")
  iysChannelCode String?            @map("iys_channel_code")
  createdById    String?            @map("created_by_id")
  createdAt      DateTime           @default(now()) @map("created_at")
  updatedAt      DateTime           @updatedAt @map("updated_at")
  restaurant     Restaurant         @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  logs           CustomerEmailLog[]

  @@index([restaurantId, createdAt])
  @@index([restaurantId, status])
  // Stage 29 — admin queue paginate hot path (status='pending_approval'
  // ORDER BY submittedAt DESC). Cross-workspace global query; restaurantId
  // index'leriyle çakışmaz çünkü WHERE clause status-only.
  @@index([status, submittedAt])
  @@map("customer_email_campaigns")
}

model CustomerEmailLog {
  id           String                @id @default(cuid())
  campaignId   String                @map("campaign_id")
  restaurantId String                @map("restaurant_id")
  contactKey   String                @map("contact_key")
  email        String
  status       String                @default("pending") // 'pending' | 'sent' | 'failed' | 'unsubscribed'
  errorMessage String?               @map("error_message") @db.Text
  sentAt       DateTime?             @map("sent_at")
  createdAt    DateTime              @default(now()) @map("created_at")
  campaign     CustomerEmailCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  restaurant   Restaurant            @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@unique([campaignId, contactKey]) // dedupe per campaign
  @@index([campaignId])
  @@index([restaurantId, createdAt])
  @@map("customer_email_logs")
}

// Stage 29 §38.105 — admin in-app notification feed.
//
// Generic feed: campaign moderation event'leri (submitted/approved/rejected),
// gelecekte audit/lifecycle/system event'leri için extend edilebilir. Owner
// NotificationBell (CLAUDE.md §38.100) paralel: 60s polling, mark-as-read
// state, drop-down panel. Admin layout topbar'a mount.
//
// adminId nullable → broadcast pattern (tüm admin'ler görür). adminId set →
// targeted notification (örn. ileride spesifik admin'e atama). type literal:
// 'campaign.submitted' | 'campaign.approved' | 'campaign.rejected' | ... .
// payload Json: {campaignId, restaurantId, ownerName, restaurantName, ...}.
// readAt nullable → unread state; mark-as-read endpoint set eder.
//
// Index'ler: (adminId, readAt, createdAt) feed query (per-admin + unread filter
// + chronological); (type, createdAt) admin filter + analytics.
model AdminNotification {
  id        String    @id @default(cuid())
  adminId   String?   @map("admin_id") // null = broadcast (tüm admin'ler)
  type      String // 'campaign.submitted' | 'campaign.approved' | 'campaign.rejected'
  title     String // TR display title (locale-aware caller eder)
  body      String?   @db.Text // detail body (opsiyonel)
  payload   Json? // {campaignId, restaurantId, ownerName, ...}
  readAt    DateTime? @map("read_at")
  createdAt DateTime  @default(now()) @map("created_at")

  admin AdminUser?              @relation(fields: [adminId], references: [id], onDelete: Cascade)
  reads AdminNotificationRead[]

  @@index([adminId, readAt, createdAt])
  @@index([type, createdAt])
  @@map("admin_notifications")
}

model AdminNotificationRead {
  notificationId String   @map("notification_id")
  adminId        String   @map("admin_id")
  readAt         DateTime @default(now()) @map("read_at")

  notification AdminNotification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  admin        AdminUser         @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@id([notificationId, adminId])
  @@index([adminId, readAt])
  @@map("admin_notification_reads")
}

// Stage 98 — Survey system (CLAUDE.md §42). Restoran sahipleri yorum
// sisteminden ayrı, hedeflenmiş anketler oluşturup QR ile dağıtır. İki
// anket tipi destekleniyor:
//   - single     : tek soru + KVKK + gönder (hızlı NPS / memnuniyet)
//   - multi_step : adım göstergeli, soru başına bir ekran
//
// QR akışı her anket için ayrı: owner panelden anket detay sayfasında
// /api/surveys/[id]/qr endpoint'i PNG/SVG üretir; QR /s/[slug] public
// URL'sine yönlendirir. Slug @unique — çakışma olasılığı server-side
// kontrol edilir (POST/duplicate path'lerinde).
//
// KVKK: Public surveys aynı /r/[slug] consent paternine uyar — KVKK onayı
// submit zorunlu (action implies consent), marketing onayı default OFF
// (opt-in, GDPR Article 7). hasKvkkConsent ve hasMarketingConsent her
// response'a yazılır (audit trail).
//
// Retention: SurveyResponse.ipAddress KVKK 90-day anonimleştirme cron'una
// (CLAUDE.md §13.9 + /api/cron/anonymize-ips) aday — şu an cron sadece
// Feedback tablosunu tarıyor, ileride genişletilebilir.
model Survey {
  id                      String    @id @default(cuid())
  restaurantId            String    @map("restaurant_id")
  // Slug public /s/[slug] URL'i için. Owner panelden yaratım sırasında
  // başlıktan türetilir, çakışma varsa server -2 / -3 suffix ekler.
  slug                    String    @unique
  title                   String
  description             String?   @db.Text
  // 'single' (tek soru) | 'multi_step' (aşamalı). Server-side enum
  // validation (Zod). UI iki farklı public render path'i (PublicSurveyView
  // component switch'i).
  type                    String    @default("multi_step")
  // Master switch — admin/owner pasif yapınca public /s/[slug] 404 döner.
  // Soft-disable; response history korunur.
  isActive                Boolean   @default(true) @map("is_active")
  // Owner draft → publish ayrımı. isPublished=false iken public URL 404
  // (draft test owner'a açık değil — preview path ayrı, /dashboard/surveys/[id]).
  isPublished             Boolean   @default(false) @map("is_published")
  publishedAt             DateTime? @map("published_at")
  // Pulse design: accent rengi public form'da CTA + adım indicator için
  // kullanılır. Null → restaurant.primaryColor fallback.
  accentColor             String?   @map("accent_color")
  // Owner kendi teşekkür mesajını yazabilir (TR/EN olmasa da bir locale —
  // anket dili owner kararı). Null → locale-aware default.
  thankYouMessage         String?   @map("thank_you_message") @db.Text
  // Owner KVKK metnini override edebilir (mevcut restaurant.kvkkText
  // paterni). Null → restaurant.kvkkText veya generic site KVKK fallback.
  kvkkText                String?   @map("kvkk_text") @db.Text
  // Marketing iznini sor (opt-in checkbox). Default false: çoğu anket
  // marketing onayı toplamaya çalışmaz, sadece veri toplar.
  collectMarketingConsent Boolean   @default(false) @map("collect_marketing_consent")
  // İletişim alanları (email + phone) opsiyonel olarak göster. Default
  // true: owner takip etmek isteyebilir. False → tamamen anonim.
  collectContact          Boolean   @default(true) @map("collect_contact")
  // Stage 99 — Tasarım handoff "Sana özel kupon" kartı. Owner anket
  // tamamlama ödülü olarak bir kupon kodu (örn. "BUAZE10") tanımlayabilir.
  // Null → kupon kartı public thanks ekranında gizlenir. couponLabel
  // owner'ın kopyada yazacağı kısa açıklama ("10% indirim" gibi); null
  // ise locale-aware default kullanılır. Tasarım: dashed border + dual
  // scalloped cutouts + lime kopya butonu (CLAUDE.md §42).
  couponCode              String?   @map("coupon_code")
  couponLabel             String?   @map("coupon_label")
  createdAt               DateTime  @default(now()) @map("created_at")
  updatedAt               DateTime  @updatedAt @map("updated_at")

  restaurant Restaurant       @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  questions  SurveyQuestion[]
  responses  SurveyResponse[]

  @@index([restaurantId, isActive, createdAt])
  @@index([slug])
  @@map("surveys")
}

// Tek soru. Anket tipinden bağımsız (single tip 1 soru taşır, multi_step
// 2-N soru taşır). sortOrder DnD ile yönetilir (mevcut menu builder
// paterni — CLAUDE.md §12.1).
//
// `type`:
//   - rating          : 1-5 yıldız
//   - nps             : 0-10 Net Promoter Score
//   - short_text      : tek satır metin (≤200 char)
//   - long_text       : çok satır metin (≤2000 char)
//   - multiple_choice : tek seçim, options JSON dizisi (2-6 seçenek)
//
// `options` yalnız multiple_choice için anlamlı: ["Seçenek 1", "Seçenek 2"].
// Server-side max 6, min 2 zorlanır. JSON çünkü Postgres array tipini
// Prisma'da kullanmak fazladan ceremoniel (mevcut MenuAnalyticsEvent
// paterni — JSON metadata).
model SurveyQuestion {
  id        String   @id @default(cuid())
  surveyId  String   @map("survey_id")
  text      String   @db.Text
  type      String
  options   Json?
  required  Boolean  @default(true)
  // Stage'ler/sortlama için. POST'ta last + 10 atanır; reorder sonrası
  // 0,1,2... sıkıştırılır (mevcut menu paterni).
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  survey  Survey         @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  answers SurveyAnswer[]

  @@index([surveyId, sortOrder])
  @@map("survey_questions")
}

// Bir müşterinin anketi (kısmen veya tam) doldurma kaydı. completedAt
// null = devam ediyor / yarım kalmış; not null = tüm zorunlu sorular
// yanıtlandı. Tamamlanma oranı (completion rate) bu field üzerinden
// hesaplanır (analytics).
//
// sessionId localStorage'dan gelir (mevcut analytics-session.ts helper'ı
// reuse — UUID, 30 dk idle rotate). Aynı session aynı ankete tekrar
// gönderemez (DB unique constraint + client-side guard).
model SurveyResponse {
  id                  String    @id @default(cuid())
  surveyId            String    @map("survey_id")
  sessionId           String    @map("session_id")
  email               String?
  phone               String?
  hasKvkkConsent      Boolean   @default(false) @map("has_kvkk_consent")
  hasMarketingConsent Boolean   @default(false) @map("has_marketing_consent")
  completedAt         DateTime? @map("completed_at")
  ipAddress           String?   @map("ip_address")
  userAgent           String?   @map("user_agent") @db.Text
  createdAt           DateTime  @default(now()) @map("created_at")

  survey  Survey         @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  answers SurveyAnswer[]

  // Aynı session aynı ankete bir kez yanıt verir.
  @@unique([surveyId, sessionId])
  @@index([surveyId, createdAt])
  @@index([surveyId, completedAt])
  @@index([ipAddress, createdAt])
  @@map("survey_responses")
}

// Tek bir soruya verilen cevap. type'a göre ilgili field doldurulur:
//   - rating / nps        → numberValue
//   - short_text / long_text → textValue
//   - multiple_choice     → optionValue (seçilen seçeneğin text'i)
//
// Tek tablo, polymorphic değer sütunları — abstraction kaçınma ilkesi
// (CLAUDE.md §7): tip başına 4 ayrı tablo overkill.
model SurveyAnswer {
  id          String   @id @default(cuid())
  responseId  String   @map("response_id")
  questionId  String   @map("question_id")
  textValue   String?  @map("text_value") @db.Text
  numberValue Int?     @map("number_value")
  optionValue String?  @map("option_value")
  createdAt   DateTime @default(now()) @map("created_at")

  response SurveyResponse @relation(fields: [responseId], references: [id], onDelete: Cascade)
  question SurveyQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([responseId, questionId])
  @@index([questionId, createdAt])
  @@map("survey_answers")
}

// =========================================================================
// Denetim Merkezi — Internal Audit Center
// =========================================================================
//
// CLAUDE.md §42. Restoran sahibinin kendi ekibi/operasyonu için quiz +
// checklist + puanlama. Survey* modellerinden ayrı tutuldu: Survey müşteri-
// facing public form'lar için (NPS, memnuniyet), Audit* iç kullanım için
// (hiring quiz, operasyonel kontrol, eğitim).
//
// 6 model:
//   - AuditCategory       : superadmin-yönetilen taksonomi (sektör + ikon)
//   - AuditTemplate       : şablon (global = restaurantId null veya
//                           restoran-özel = restaurantId dolu)
//   - AuditQuestion       : sırayla sorular (single/multi/scale/text/yes_no)
//   - AuditAssignment     : kime/ne zaman atandı (team member, candidate, link)
//   - AuditResponse       : tamamlanan veya kısmi yanıt + skor
//   - AuditAnswer         : tek soruya cevap + auto/manual puan
//
// Scoring modları:
//   - percentage : (toplam doğru / toplam soru) × 100
//   - weighted   : Σ(question.weight × correct) / Σ(weight) × 100
//   - pass_fail  : passingScore eşiği üstü = passed
//
// IDOR: src/lib/audits/access.ts wrapper'ları kullanılır. Global template
// (restaurantId null) yalnız superadmin tarafından yazılabilir; herkes
// okuyup fork edebilir (kendi restoranına klon).

// Audit kategorisi — superadmin tarafından yönetilir. Owner template
// oluştururken kategori seçer; UI filter + sektör eşleştirmesi için.
model AuditCategory {
  id      String  @id @default(cuid())
  slug    String  @unique
  labelTr String  @map("label_tr")
  labelEn String  @map("label_en")
  // Sektör taksonomi — CLAUDE.md §5 platform sektör paterniyle uyumlu.
  // food | hotel | retail | health | beauty | other. Schema'da string;
  // helper'da literal union zorlanır.
  sector  String  @default("other")
  // Lucide icon adı (UI'da `<DynamicIcon name>` render). Boşsa default
  // "ClipboardCheck" kullanılır.
  iconKey String? @map("icon_key")
  // UI sıralama. POST'ta last + 10; reorder sonrası sıkıştırılır.
  order   Int     @default(0)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  templates AuditTemplate[]

  @@index([sector, order])
  @@map("audit_categories")
}

// Audit şablonu. restaurantId null = global (superadmin kataloğu);
// restaurantId dolu = restoran-özel (owner kendi şablonu veya bir global
// şablonu fork etmiş). Slug yok — public URL `/audits/[token]` üzerinden
// AuditAssignment.token ile gider (her atama ayrı token).
model AuditTemplate {
  id           String         @id @default(cuid())
  restaurantId String?        @map("restaurant_id")
  restaurant   Restaurant?    @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  categoryId   String?        @map("category_id")
  category     AuditCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  title        String
  description  String?        @db.Text
  // Sektör snapshot (global template'lerde category.sector ile eşleşir;
  // owner fork ederse kendi sektörünü override edebilir).
  sector       String         @default("other")
  // 'percentage' | 'weighted' | 'pass_fail'. Server-side enum (Zod).
  scoringMode  String         @default("percentage") @map("scoring_mode")
  // pass_fail için zorunlu (Int 0-100); percentage/weighted için opsiyonel
  // (sadece "geçti" rozeti göstermek için).
  passingScore Int?           @map("passing_score")
  // Şablon dili — questions/options bu dilde yazılır. Owner i18n manuel
  // yapar (henüz auto-translate yok).
  locale       String         @default("tr")
  // Yayın akışı — Survey paterniyle aynı. isPublished=false iken atama
  // yapılamaz; draft olarak owner kendi yanıt deneyebilir.
  isPublished  Boolean        @default(false) @map("is_published")
  publishedAt  DateTime?      @map("published_at")
  // Şablon arşivlendiğinde isActive=false; mevcut atamalar/yanıtlar
  // okunabilir kalır ama yeni atama yapılamaz.
  isActive     Boolean        @default(true) @map("is_active")
  // Hangi tip atayıcı yarattı — denetim trail. 'superadmin' = Buaze
  // global katalog; 'owner' = restoran sahibi; 'manager' = TeamMember.
  // String — actor.source ile uyumlu (CLAUDE.md §4).
  createdBy    String?        @map("created_by")
  createdById  String?        @map("created_by_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  questions   AuditQuestion[]
  assignments AuditAssignment[]
  responses   AuditResponse[]

  // Global katalog browse'u: restaurantId null + isPublished true + sector.
  @@index([restaurantId, isPublished, isActive])
  @@index([categoryId, isPublished])
  @@index([sector, isPublished])
  @@map("audit_templates")
}

// AuditQuestion — tek soru. type'a göre options/correctAnswer/scoringRule
// kullanımı:
//   - single (tek seçim çoktan seçmeli): options ["A", "B", ...]; correctAnswer
//     = "A" (quiz mode için)
//   - multi (çoklu seçim): options aynı; correctAnswer = ["A", "C"]
//   - scale (1-5 Likert): options yok; correctAnswer opsiyonel (eşik puan)
//   - text (serbest metin): options yok; correctAnswer yok (manuel score)
//   - yes_no: options ["Evet", "Hayır"]; correctAnswer "Evet" veya "Hayır"
//   - file: ek upload (Faz sonraki dalga — Supabase Storage gerekli)
//
// weight: weighted scoring için (default 1). isRequired=false → skip
// edilebilir (atlandığında autoScore=0 sayılır).
model AuditQuestion {
  id            String        @id @default(cuid())
  templateId    String        @map("template_id")
  template      AuditTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  // Soru tipi: 'single' | 'multi' | 'scale' | 'text' | 'yes_no' | 'file'.
  type          String
  prompt        String        @db.Text
  // Yardım metni — owner soruyu açıklayabilir ("Hijyen kurallarına dair...").
  helpText      String?       @map("help_text") @db.Text
  options       Json?
  // Quiz mode için doğru cevap. Tipine göre string veya string[].
  correctAnswer Json?         @map("correct_answer")
  // Weighted scoring için ağırlık (Int 1-10). Default 1; pass_fail/percentage
  // modunda yok sayılır.
  weight        Int           @default(1)
  // İleride genişletme için (partial credit, regex match vb.). Şimdilik
  // null; helper auto-score basit eşitlik kontrolü yapar.
  scoringRule   Json?         @map("scoring_rule")
  isRequired    Boolean       @default(true) @map("is_required")
  sortOrder     Int           @default(0) @map("sort_order")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  answers AuditAnswer[]

  @@index([templateId, sortOrder])
  @@map("audit_questions")
}

// AuditAssignment — bir denetimin kime ve ne zaman gideceği. Tek atama
// birden çok yanıt üretebilir (recurrence) — her recurrence yeni
// AuditAssignment row değil, mevcut row'un response listesi büyür.
//
// assigneeType:
//   - 'team_member' : assigneeTeamMemberId dolu, panel akışı
//   - 'candidate'   : candidateEmail/candidatePhone dolu, public link
//   - 'self'        : owner kendi test ediyor (preview)
//   - 'link'        : anonim public link, kime gittiği belirsiz
//
// recurrence:
//   - 'once'    : tek atama, completedAt sonra status=completed
//   - 'daily' / 'weekly' / 'monthly' : cron her döngüde yeni response
//     oluşturma yetkisi verir (Faz 5 — /api/cron/audit-recurrence).
//
// token: assigneeType 'candidate' veya 'link' için public URL. 32 byte
// hex. Cancel veya completion sonrası tokenRevoked=true yapılır.
model AuditAssignment {
  id                   String        @id @default(cuid())
  templateId           String        @map("template_id")
  template             AuditTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  restaurantId         String        @map("restaurant_id")
  restaurant           Restaurant    @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  // 'team_member' | 'candidate' | 'self' | 'link'
  assigneeType         String        @map("assignee_type")
  // TeamMember.id (FK yok — Json locations paterniyle uyumlu)
  assigneeTeamMemberId String?       @map("assignee_team_member_id")
  // Aday için iletişim. team_member için null.
  assigneeName         String?       @map("assignee_name")
  assigneeEmail        String?       @map("assignee_email")
  assigneePhone        String?       @map("assignee_phone")
  // Notes — atayan kişi aday hakkında not bırakabilir (private).
  internalNote         String?       @map("internal_note") @db.Text
  // 'once' | 'daily' | 'weekly' | 'monthly'
  recurrence           String        @default("once")
  // İleri tarih — Faz 5 cron bu tarihte hatırlatma gönderir; geçtiyse
  // overdue işaretler.
  dueAt                DateTime?     @map("due_at")
  // 'pending' | 'sent' | 'in_progress' | 'completed' | 'overdue' | 'cancelled'
  status               String        @default("pending")
  // Public link akışı için token. assigneeType 'candidate' veya 'link' iken
  // dolu. Cancel/done sonrası tokenRevoked=true.
  token                String?       @unique
  tokenRevoked         Boolean       @default(false) @map("token_revoked")
  // Atayan actor. createdBy actor.source ('superadmin'|'manager'|'owner');
  // createdById actor.id.
  createdBy            String?       @map("created_by")
  createdById          String?       @map("created_by_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  responses AuditResponse[]

  @@index([restaurantId, status, dueAt])
  @@index([templateId, status])
  @@index([assigneeTeamMemberId, status])
  @@map("audit_assignments")
}

// AuditResponse — bir denetimi (kısmen veya tam) doldurma kaydı. score +
// scorePercentage server-side computed (src/lib/audits/score.ts) — submit
// anında veya manuel re-score sonrası set edilir.
//
// startedAt/completedAt timeline:
//   - GET /audits/[token] ilk açılışta startedAt set + status 'in_progress'
//   - POST submit'te completedAt + score hesap
//   - completedAt null → kısmi/draft
//
// reviewedById: subjective text answer'lar için owner manuel re-score
// yapınca işaretlenir (auditTrail).
model AuditResponse {
  id                  String           @id @default(cuid())
  templateId          String           @map("template_id")
  template            AuditTemplate    @relation(fields: [templateId], references: [id], onDelete: Cascade)
  assignmentId        String?          @map("assignment_id")
  assignment          AuditAssignment? @relation(fields: [assignmentId], references: [id], onDelete: SetNull)
  restaurantId        String           @map("restaurant_id")
  restaurant          Restaurant       @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  // Public link yanıtlarında respondentName/Email/Phone doludur (KVKK
  // consent submit ile). Team member yanıtlarında teamMemberId dolu.
  respondentName      String?          @map("respondent_name")
  respondentEmail     String?          @map("respondent_email")
  respondentPhone     String?          @map("respondent_phone")
  teamMemberId        String?          @map("team_member_id")
  // KVKK / marketing consent — public link akışı (CLAUDE.md §19.1)
  hasKvkkConsent      Boolean          @default(false) @map("has_kvkk_consent")
  hasMarketingConsent Boolean          @default(false) @map("has_marketing_consent")
  // Skor — null iken kısmi; submit sonrası set. Int çünkü puan formülleri
  // tam sayıya yuvarlar. scorePercentage 0-10000 sklı (2 ondalık duyarlık,
  // 10000 = %100.00) — Decimal eklemekten kaçınma (Postgres int basit).
  score               Int?             @map("score")
  scorePercentage     Int?             @map("score_percentage")
  passed              Boolean?         @map("passed")
  startedAt           DateTime         @default(now()) @map("started_at")
  completedAt         DateTime?        @map("completed_at")
  // Manuel re-score sonrası owner/superadmin işaretler.
  reviewedById        String?          @map("reviewed_by_id")
  reviewedAt          DateTime?        @map("reviewed_at")
  reviewNote          String?          @map("review_note") @db.Text
  ipAddress           String?          @map("ip_address")
  userAgent           String?          @map("user_agent") @db.Text

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  answers AuditAnswer[]

  @@index([restaurantId, completedAt])
  @@index([templateId, completedAt])
  @@index([assignmentId, completedAt])
  @@index([teamMemberId, completedAt])
  @@map("audit_responses")
}

// AuditAnswer — tek soruya verilen cevap. Polymorphic value Json'da
// (string veya string[] tip'e göre). autoScore = server-side computed;
// manualScore = owner override (subjective text için).
//
// Final puan: manualScore ?? autoScore (manuel override önceliği).
model AuditAnswer {
  id          String        @id @default(cuid())
  responseId  String        @map("response_id")
  response    AuditResponse @relation(fields: [responseId], references: [id], onDelete: Cascade)
  questionId  String        @map("question_id")
  question    AuditQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  // Cevap — type'a göre string, string[], number, ya da file URL. Json
  // (polymorphic — Survey paterniyle aynı).
  value       Json?
  // Otomatik puan (server compute). Quiz mode için doğru cevapla eşleşme.
  autoScore   Int?          @map("auto_score")
  // Manuel override (text answer'ları için reviewer tarafından).
  manualScore Int?          @map("manual_score")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([responseId, questionId])
  @@index([questionId, createdAt])
  @@map("audit_answers")
}

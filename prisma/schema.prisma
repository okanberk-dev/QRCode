generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id            String       @id @default(cuid())
  email         String       @unique
  passwordHash  String       @map("password_hash")
  name          String?
  role          String       @default("restaurant_owner")
  plan          String       @default("trial")      // trial | monthly | yearly
  trialEndsAt   DateTime?    @map("trial_ends_at")
  locale        String       @default("tr")
  isActive      Boolean      @default(true) @map("is_active")
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")

  restaurants   Restaurant[]

  @@map("users")
}

model Restaurant {
  id                String     @id @default(cuid())
  slug              String     @unique
  name              String
  category          String     @default("Restoran")
  address           String?
  phone             String?
  workingHours      String?    @map("working_hours")
  googlePlaceId     String?    @map("google_place_id")
  googleReviewUrl   String?    @map("google_review_url")
  getirYemekUrl     String?    @map("getir_yemek_url")
  yemekSepetiUrl    String?    @map("yemek_sepeti_url")
  trendyolYemekUrl  String?    @map("trendyol_yemek_url")
  notificationEmail String?    @map("notification_email")
  primaryColor      String     @default("#1a73e8")
  isActive          Boolean    @default(true) @map("is_active")
  menuEnabled       Boolean    @default(true) @map("menu_enabled")
  menuPublished     Boolean    @default(false) @map("menu_published")
  menuLogoUrl       String?    @map("menu_logo_url")
  menuUpdatedAt     DateTime?  @map("menu_updated_at")
  menuTheme         String     @default("classic") @map("menu_theme")
  menuAccentColor   String?    @map("menu_accent_color")
  createdAt         DateTime   @default(now()) @map("created_at")
  updatedAt         DateTime   @updatedAt @map("updated_at")

  userId            String?    @map("user_id")
  user              User?      @relation(fields: [userId], references: [id])

  feedbacks         Feedback[]
  qrGenerations     QrGeneration[]
  adminUsers        AdminUser[]
  menuCategories    MenuCategory[]
  menuItems         MenuItem[]
  analyticsEvents   MenuAnalyticsEvent[]
  brandSettings     BrandSettings?

  @@map("restaurants")
}

model QrGeneration {
  id            String      @id @default(cuid())
  qrUrl         String      @map("qr_url")
  tableNumber   String?     @map("table_number")
  platform      String?     @map("platform")    // google | yemeksepeti | getir | trendyol_go
  serviceType   String?     @map("service_type") // dine_in | takeout | delivery
  type          String      @default("feedback") @map("type") // feedback | menu
  createdAt     DateTime    @default(now()) @map("created_at")

  restaurantId  String      @map("restaurant_id")
  restaurant    Restaurant  @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId, createdAt])
  @@map("qr_generations")
}

model Feedback {
  id                  String      @id @default(cuid())
  rating              Int
  name                String?
  email               String?
  phone               String?
  comment             String?
  source              String?
  branch              String?
  tableNumber         String?     @map("table_number")
  ipAddress           String?     @map("ip_address")
  userAgent           String?     @map("user_agent")
  hasKvkkConsent      Boolean     @default(true) @map("has_kvkk_consent")
  hasMarketingConsent Boolean     @default(false) @map("has_marketing_consent")
  platform            String?     @map("platform")   // google | yemeksepeti | getir | trendyol_go

  // Rich Feedback Additions
  serviceType         String?     @map("service_type")
  foodRating          Int?        @map("food_rating")
  serviceRating       Int?        @map("service_rating")
  atmosphereRating    Int?        @map("atmosphere_rating")

  createdAt           DateTime    @default(now()) @map("created_at")

  restaurantId        String?     @map("restaurant_id")
  restaurant          Restaurant? @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  replies             FeedbackReply[]
  flag                FeedbackFlag?
  assignment          FeedbackAssignment?
  tags                FeedbackTag[]

  @@index([restaurantId, createdAt])
  @@index([ipAddress, createdAt])
  @@map("feedback")
}

model FeedbackReply {
  id           String   @id @default(cuid())
  feedbackId   String   @map("feedback_id")
  feedback     Feedback @relation(fields: [feedbackId], references: [id], onDelete: Cascade)
  authorUserId String   @map("author_user_id")
  body         String   @db.Text
  channel      String   @default("internal") // internal | google | email
  status       String   @default("sent")     // draft | sent | failed
  createdAt    DateTime @default(now())      @map("created_at")

  @@index([feedbackId, createdAt])
  @@map("feedback_replies")
}

model FeedbackFlag {
  id         String   @id @default(cuid())
  feedbackId String   @unique @map("feedback_id")
  feedback   Feedback @relation(fields: [feedbackId], references: [id], onDelete: Cascade)
  reason     String?
  flaggedBy  String   @map("flagged_by_user_id")
  createdAt  DateTime @default(now()) @map("created_at")

  @@map("feedback_flags")
}

model FeedbackAssignment {
  id           String   @id @default(cuid())
  feedbackId   String   @unique @map("feedback_id")
  feedback     Feedback @relation(fields: [feedbackId], references: [id], onDelete: Cascade)
  assigneeId   String   @map("assignee_user_id")
  assignedById String   @map("assigned_by_user_id")
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("feedback_assignments")
}

model FeedbackTag {
  id         String   @id @default(cuid())
  feedbackId String   @map("feedback_id")
  feedback   Feedback @relation(fields: [feedbackId], references: [id], onDelete: Cascade)
  label      String
  score      Int?
  createdAt  DateTime @default(now()) @map("created_at")

  @@unique([feedbackId, label])
  @@index([feedbackId])
  @@map("feedback_tags")
}

model AutomationRule {
  id           String   @id @default(cuid())
  userId       String   @map("user_id")
  restaurantId String?  @map("restaurant_id")
  trigger      String
  threshold    String?
  action       String
  target       String?
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@index([userId, isActive])
  @@index([userId, restaurantId])
  @@map("automation_rules")
}

model ApiKey {
  id         String    @id @default(cuid())
  userId     String    @map("user_id")
  name       String
  prefix     String
  tokenHash  String    @map("token_hash")
  scopes     String[]  @default([])
  lastUsedAt DateTime? @map("last_used_at")
  revokedAt  DateTime? @map("revoked_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@index([prefix])
  @@map("api_keys")
}

model BrandSettings {
  restaurantId String     @id @map("restaurant_id")
  logoUrl      String?    @map("logo_url")
  accentColor  String?    @map("accent_color")
  accentFont   String?    @map("accent_font")
  updatedAt    DateTime   @default(now()) @updatedAt @map("updated_at")

  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@map("brand_settings")
}

model GoogleIntegration {
  id            String   @id @default(cuid())
  userId        String   @unique @map("user_id")
  accessToken   String   @map("access_token")
  refreshToken  String?  @map("refresh_token")
  expiresAt     DateTime @map("expires_at")
  accountId     String?  @map("account_id")
  locationsJson Json?    @map("locations_json")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@map("google_integrations")
}

model TeamMember {
  id         String   @id @default(cuid())
  ownerId    String   @map("owner_user_id")
  email      String
  name       String?
  role       String   @default("manager")  // owner | manager | staff | viewer
  locations  Json?    // string[] — restaurant ids
  status     String   @default("invited")  // invited | active | revoked
  lastSeenAt DateTime? @map("last_seen_at")
  createdAt  DateTime @default(now()) @map("created_at")

  @@unique([ownerId, email])
  @@index([ownerId, status])
  @@map("team_members")
}

model Campaign {
  id             String   @id @default(cuid())
  userId         String   @map("user_id")
  restaurantId   String?  @map("restaurant_id")
  name           String
  placement      String   // table | receipt | door | pack
  count          Int      @default(1)
  template       String   @default("lime") // lime | white | dark | minimal
  color          String   @default("#C6F24E")
  status         String   @default("draft") // draft | live | archived
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@index([userId, status])
  @@index([userId, restaurantId])
  @@map("campaigns")
}

model NotificationPreference {
  userId           String   @id @map("user_id")
  lowRatingEmail   Boolean  @default(true)  @map("low_rating_email")
  dailyDigestEmail Boolean  @default(false) @map("daily_digest_email")
  weeklyReport     Boolean  @default(true)  @map("weekly_report")
  slackWebhook     String?  @map("slack_webhook")
  updatedAt        DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("notification_preferences")
}

model AdminUser {
  id           String      @id @default(cuid())
  username     String      @unique
  passwordHash String      @map("password_hash")
  role         String      @default("superadmin")
  restaurantId String?     @map("restaurant_id")
  
  restaurant   Restaurant? @relation(fields: [restaurantId], references: [id])

  @@map("admin_users")
}

model Settings {
  id    String @id @default(cuid())
  key   String @unique
  value String

  @@map("settings")
}

model Announcement {
  id            String    @id @default(cuid())
  title         String
  message       String    @db.Text
  status        String    @default("draft")
  severity      String    @default("info")
  locale        String    @default("all")
  priority      Int       @default(0)
  startDate     DateTime? @map("start_date")
  endDate       DateTime? @map("end_date")
  ctaText       String?   @map("cta_text")
  ctaLink       String?   @map("cta_link")
  isDismissible Boolean   @default(true) @map("is_dismissible")
  createdBy     String?   @map("created_by")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  @@index([status, startDate, endDate])
  @@map("announcements")
}

model MenuCategory {
  id           String     @id @default(cuid())
  restaurantId String     @map("restaurant_id")
  name         String
  description  String?
  sortOrder    Int        @default(0) @map("sort_order")
  isVisible    Boolean    @default(true) @map("is_visible")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  items        MenuItem[]

  @@index([restaurantId, sortOrder])
  @@map("menu_categories")
}

model MenuItem {
  id           String       @id @default(cuid())
  restaurantId String       @map("restaurant_id")
  categoryId   String       @map("category_id")
  name         String
  description  String?
  priceCents   Int          @default(0) @map("price_cents")
  currency     String       @default("TRY")
  imageUrl     String?      @map("image_url")
  badges       String[]     @default([])
  isAvailable  Boolean      @default(true) @map("is_available")
  isOutOfStock Boolean      @default(false) @map("is_out_of_stock")
  sortOrder    Int          @default(0) @map("sort_order")
  deletedAt    DateTime?    @map("deleted_at")
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  restaurant   Restaurant   @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  category     MenuCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@index([restaurantId])
  @@index([categoryId, sortOrder])
  @@map("menu_items")
}

model MenuAnalyticsEvent {
  id           String     @id @default(cuid())
  restaurantId String     @map("restaurant_id")
  categoryId   String?    @map("category_id")
  productId    String?    @map("product_id")
  eventType    String     @map("event_type")   // menu_view | menu_category_click | menu_product_view | menu_product_click | menu_upsell_click
  sessionId    String     @map("session_id")
  sourceType   String?    @map("source_type")  // qr | direct | table | link | delivery
  metadata     Json?
  createdAt    DateTime   @default(now()) @map("created_at")

  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId, eventType, createdAt])
  @@index([restaurantId, categoryId, eventType, createdAt])
  @@index([restaurantId, productId, eventType, createdAt])
  @@index([restaurantId, sessionId, createdAt])
  @@index([restaurantId, sourceType, createdAt])
  @@map("menu_analytics_events")
}

model BlogPost {
  id          String   @id @default(cuid())
  slug        String
  locale      String   // 'tr' or 'en'
  title       String
  description String
  content     String   @db.Text
  date        String
  readTime    String   @map("read_time")
  author      String
  coverImage  String   @map("cover_image")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@unique([slug, locale])
  @@map("blog_posts")
}

model CaseStudy {
  id          String   @id @default(cuid())
  slug        String   @unique
  brand       String
  sector      String
  sectorEn    String?  @map("sector_en")
  location    String
  heroImage   String   @map("hero_image")
  heroTr      String   @db.Text @map("hero_tr")
  heroEn      String   @db.Text @map("hero_en")
  subtitleTr  String?  @db.Text @map("subtitle_tr")
  subtitleEn  String?  @db.Text @map("subtitle_en")
  stats       Json     // [{label:{tr,en}, value}]
  highlights  Json     // [{tr, en}]
  quoteTr     String?  @db.Text @map("quote_tr")
  quoteEn     String?  @db.Text @map("quote_en")
  personName  String?  @map("person_name")
  personRole  Json?    @map("person_role") // {tr, en}
  isPublished Boolean  @default(true) @map("is_published")
  publishedAt DateTime @default(now()) @map("published_at")

  @@index([isPublished, publishedAt])
  @@map("case_studies")
}

model OnboardingProgress {
  userId      String    @id @map("user_id")
  step        Int       @default(1)
  data        Json?
  completedAt DateTime? @map("completed_at")
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at")

  @@map("onboarding_progress")
}

model NewsletterSubscriber {
  id             String    @id @default(cuid())
  email          String    @unique
  locale         String    @default("tr")
  source         String?
  ip             String?
  createdAt      DateTime  @default(now()) @map("created_at")
  unsubscribedAt DateTime? @map("unsubscribed_at")

  @@index([createdAt])
  @@map("newsletter_subscribers")
}

model ROIRequest {
  id             String   @id @default(cuid())
  email          String?
  restaurantName String?  @map("restaurant_name")
  tables         Int?
  avgTicket      Decimal? @db.Decimal(10, 2) @map("avg_ticket")
  noShowRate     Float?   @map("no_show_rate")
  projection     Json?
  ip             String?
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([email, createdAt])
  @@map("roi_requests")
}

model HelpArticle {
  id          String   @id @default(cuid())
  slug        String
  locale      String   @default("tr") // tr | en
  category    String
  title       String
  excerpt     String?  @db.Text
  body        String   @db.Text
  searchTags  String[] @default([]) @map("search_tags")
  isPublished Boolean  @default(true) @map("is_published")
  order       Int      @default(0)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at")

  @@unique([slug, locale])
  @@index([locale, category, order])
  @@index([isPublished, updatedAt])
  @@map("help_articles")
}

model CareerApplication {
  id         String   @id @default(cuid())
  name       String
  email      String
  roleSlug   String?  @map("role_slug")
  message    String?  @db.Text
  portfolio  String?
  attachment String?
  locale     String   @default("tr")
  ip         String?
  status     String   @default("new")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([roleSlug, createdAt])
  @@index([status, createdAt])
  @@map("career_applications")
}

model BillingSubscription {
  userId       String    @id @map("user_id")
  plan         String    @default("trial")  // trial | monthly | yearly | enterprise
  status       String    @default("active") // active | past_due | canceled
  trialEndsAt  DateTime? @map("trial_ends_at")
  renewsAt     DateTime? @map("renews_at")
  providerRef  String?   @unique @map("provider_ref")
  paymentBrand String?   @map("payment_brand")
  paymentLast4 String?   @map("payment_last4")
  updatedAt    DateTime  @default(now()) @updatedAt @map("updated_at")

  @@map("billing_subscriptions")
}

model BillingInvoice {
  id          String   @id @default(cuid())
  userId      String   @map("user_id")
  amount      Decimal  @db.Decimal(10, 2)
  currency    String   @default("TRY")
  status      String   @default("paid") // paid | pending | failed | refunded
  providerRef String?  @unique @map("provider_ref")
  pdfUrl      String?  @map("pdf_url")
  issuedAt    DateTime @default(now()) @map("issued_at")

  @@index([userId, issuedAt])
  @@map("billing_invoices")
}

  title       String
  description String
  content     String  @db.Text
  date        String
  readTime    String  @map("read_time")
  author      String
  // Either an absolute URL or a base64 data URL (admin upload via
  // /api/admin/blog/upload-image). @db.Text required because data URLs
  // can exceed VARCHAR(255) — see CLAUDE.md §3.
  coverImage  String  @map("cover_image") @db.Text
  isActive    Boolean @default(true) @map("is_active")
  // Public page view counter — fire-and-forget incremented when the post
  // renders at /[locale]/blog/[slug]. Default 0 keeps existing rows safe.
  viewCount   Int     @default(0) @map("view_count")

  // Optional public-render overrides — fall back to defaults when null.
  // Wired by BlogPostEditor "Public görünüm" panel; consumed in
  // src/app/[locale]/blog/[slug]/page.tsx.
  authorBio       String?  @map("author_bio") @db.Text
  authorRole      String?  @map("author_role")
  tags            String[] @default([]) @map("tags")
  pullQuote       String?  @map("pull_quote") @db.Text
  pullQuoteAuthor String?  @map("pull_quote_author")
  ctaTitle        String?  @map("cta_title")
  ctaSubtitle     String?  @map("cta_subtitle") @db.Text
  ctaButtonLabel  String?  @map("cta_button_label")

  // Translation group — bir TR + bir EN post aynı groupId paylaşır.
  // Admin editör'den "Diğer dildeki karşılığı" alanıyla manuel set edilir.
  // Locale switcher / 404 fallback bu alandan karşı locale post'unu çözer.
  // Statik map (src/lib/blog-translation-pairs.ts) eski / seed yazılar için
  // korunur; yeni yazılar DB-driven bu alanı kullanır.
  translationGroupId String? @map("translation_group_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([slug, locale])
  @@index([translationGroupId])
  @@map("blog_posts")
}

model CaseStudy {

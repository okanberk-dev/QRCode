model BillingSubscription {
  userId         String    @id @map("user_id")
  /// Legacy lifecycle bucket — `trial | monthly | yearly | enterprise | free`.
  /// **Tier'ı temsil etmez** (`subscriptionPlanId` o iş için var); cycle +
  /// lifecycle karışımı (örn. "yearly" = paying yearly, "trial" = onboarding
  /// pending). Yeni billing flow'ları `subscriptionPlanId` + `billingCycle`
  /// ikilisini canonical tutar (CLAUDE.md §15.2 + §38.200).
  plan           String    @default("trial")
  status         String    @default("active") // active | past_due | canceled
  trialEndsAt    DateTime? @map("trial_ends_at")
  renewsAt       DateTime? @map("renews_at")
  providerRef    String?   @unique @map("provider_ref")
  paymentBrand   String?   @map("payment_brand")

{
  "git": {
    "deploymentEnabled": {
      "main": true
    }
  },
  "crons": [
    {
      "path": "/api/cron/weekly-digest",
      "schedule": "0 9 * * 1"
    },
    {
      "path": "/api/cron/anonymize-ips",
      "schedule": "0 3 * * 0"
    },
    {
      "path": "/api/cron/monthly-newsletter",
      "schedule": "0 12 1 * *"
    },
    {
      "path": "/api/cron/platform-link-retest",
      "schedule": "0 4 * * *"
    },
    {
      "path": "/api/cron/lifecycle-emails",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/cron/google-reviews-alert",
      "schedule": "0 7 * * *"
    },
    {
      "path": "/api/cron/expire-impersonation-sessions",
      "schedule": "0 1 * * *"
    },
    {
      "path": "/api/cron/feedback-autodraft",
      "schedule": "0 5 * * *"
    },
    {
      "path": "/api/cron/google-reviews-autodraft",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/monthly-health-snapshot",
      "schedule": "0 2 1 * *"
    },
    {
      "path": "/api/cron/monthly-health-report",
      "schedule": "0 13 1 * *"
    },
    {
      "path": "/api/cron/process-scheduled-deletions",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/rating-drop-alert",
      "schedule": "0 11 * * 1"
    },
    {
      "path": "/api/cron/billing-renewals",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/loyalty-daily",
      "schedule": "20 7 * * *"
    },
    {
      "path": "/api/cron/google-reviews-refresh",
      "schedule": "40 2 * * *"
    }
  ],
  "rewrites": [
    { "source": "/favicon.ico", "destination": "/favicon.svg" },
    { "source": "/favicon.png", "destination": "/favicon.svg" },
    { "source": "/apple-touch-icon.png", "destination": "/apple-touch-icon.svg" },
    { "source": "/apple-touch-icon-precomposed.png", "destination": "/apple-touch-icon.svg" },
    { "source": "/icon-192.png", "destination": "/apple-touch-icon.svg" },
    { "source": "/icon-512.png", "destination": "/apple-touch-icon.svg" }
  ]
}

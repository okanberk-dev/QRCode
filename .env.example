# --- DATABASE (Supabase) ---
# Pooling URL (Transaction Mode - Port 6543).
#
# `connection_limit=1` is **mandatory** for Vercel serverless. Without it
# Prisma defaults to 10 connections per Lambda × ~20 concurrent Lambdas
# = ~200 conns, which hits the Supabase pooler 200-connection cap during
# burst traffic and trips `FATAL: (EMAXCONN) max client connections
# reached`. Production wave on 1 May 2026 (CLAUDE.md §38.12) was caused
# by this drift. Each Lambda now opens exactly 1 logical connection,
# pgbouncer multiplexes underneath. CLAUDE.md §14.1 + §38.12.
DATABASE_URL="postgres://postgres.xxxx:password@aws-1-us-east-1.pooler.supabase.com:6543/postgres?sslmode=require&pgbouncer=true&connection_limit=1"
# Direct URL (Session Mode - Port 5432) — used only by `prisma migrate
# deploy` at build time, NOT at request runtime, so no connection_limit
# tuning needed here.
DIRECT_URL="postgres://postgres.xxxx:password@aws-1-us-east-1.pooler.supabase.com:5432/postgres?sslmode=require"

# --- GOOGLE MAPS / BUSINESS PROFILE ---
# Server-side Places API (New) key. Used by owner panel to search Google
# businesses and turn a selected place_id into a write-review URL.
# Restrict this key to Places API (New) in Google Cloud. Do not expose it with
# NEXT_PUBLIC_.
GOOGLE_MAPS_API_KEY=""
# OAuth client for Google Business Profile review sync/reply. Required only
# for fetching Google reviews and replying from the owner panel.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="https://your-app.vercel.app/api/integrations/google/callback"

# --- AT-REST TOKEN ENCRYPTION ---
# AES-256-GCM key for encrypting Google OAuth access/refresh tokens
# (CLAUDE.md §40.12). Optional — if unset, tokens stored as plain text
# (graceful degrade + Sentry warn). Generate a 32-byte base64 key:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Rotate by clearing google_integrations table then have owners reconnect.
ENCRYPTION_KEY=""

# --- EMAIL (Resend) ---
# Resend HTTP API is the only mail path (no SMTP fallback).
# Get a key at https://resend.com/api-keys and verify the sending domain
# at https://resend.com/domains.
RESEND_API_KEY=""
# Optional sender override; falls back to "Buaze <noreply@buaze.com>".
# Domain must be verified in Resend.
RESEND_FROM_EMAIL=""
# Default Reply-To. Marketing mail from a noreply address can trip spam
# heuristics; set this to a monitored mailbox (e.g. hello@buaze.com) so
# the "Reply" button on every mail goes somewhere real. Falls back to
# NOTIFICATION_EMAIL when unset.
RESEND_REPLY_TO=""
# Default recipient for ROI/contact/feedback notifications when a
# restaurant has no notification_email configured.
NOTIFICATION_EMAIL="owner@example.com"
# Optional careers inbox; defaults to NOTIFICATION_EMAIL.
CAREERS_INBOX_EMAIL=""
# Operator alert mailbox — receives [OPS] failure notifications when a
# critical mail (low-rating-alert, forgot-password, customer-reply) fails
# to send. Falls back to NOTIFICATION_EMAIL when unset. Set to a
# distribution list / monitored inbox in production.
OPS_EMAIL=""

# --- ADMIN AUTH ---
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="secure-password-here"
JWT_SECRET=replace_with_secure_random_string

# --- APP CONFIG ---
NEXT_PUBLIC_APP_URL="https://your-app.vercel.app"
NEXT_PUBLIC_RESTAURANT_NAME="Mamma's Burger Ankara"

# --- MARKETING HERO VARIANT (Stage 41 §38.122) ---
# Marketing homepage hero A/B test ENV flag. 3 variant — sadece BİRİ
# seçilir (HANDOFF §6.1):
#
#   • cinematic  — 9s loop, 5 sahne (QR pulse → tarama → form → AI yanıt → 4.8★)
#                  ürün-açıklama, sahneli, default. En çok bilgi taşıyan variant.
#   • starclimb  — 8s loop, headline'da 3.6→4.8 sayaç + 90 günlük climb chart.
#                  veri-odaklı, kanıtlayıcı. CLAUDE.md §35.8 kohort disclosure.
#   • parallax   — sürekli, mouse-takipli 5-katmanlı 3D kart kümesi.
#                  interaktif, premium, animation-heavy.
#
# Geçersiz değer veya unset → 'cinematic' fallback. ENV değişimi rebuild
# gerektirir (Next.js NEXT_PUBLIC_* build-time inlined). Vercel:
# Settings → Environment Variables → Production scope.
NEXT_PUBLIC_HERO_VARIANT="cinematic"

# --- CRON AUTH ---
# Bearer token for /api/cron/* endpoints (weekly-digest, anonymize-ips,
# monthly-newsletter, trial-reminders). Vercel Cron sets this header
# automatically when configured under Project → Settings → Cron Jobs.
# Generate with: openssl rand -hex 32
CRON_SECRET=""

# --- SUPABASE STORAGE (site logo/favicon/og uploads) ---
# Project URL (Supabase dashboard → Project Settings → API)
SUPABASE_URL="https://xxxx.supabase.co"
# Service role key — server-only, NEVER expose to client
SUPABASE_SERVICE_ROLE_KEY="eyJhbG..."
# Public bucket name (create in Supabase Dashboard → Storage)
SUPABASE_STORAGE_BUCKET="site-assets"

# --- SUPABASE REALTIME (Stage 16 §38.86 — ActivityFeed push) ---
# Public client envs — exposed to browser, safe (anon key + URL).
# Project Settings → API → Project URL + anon public key.
NEXT_PUBLIC_SUPABASE_URL="https://xxxx.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbG..."
# JWT secret used to mint short-lived (1h) realtime tokens server-side.
# Project Settings → API → JWT Settings → JWT Secret. Server-only — NEVER
# expose to client. Buaze auth uses jose custom JWT (CLAUDE.md §4); this
# secret is independent and ONLY used by /api/realtime/token to sign
# Supabase-compatible JWTs whose claims drive the Realtime + RLS policies.
SUPABASE_JWT_SECRET=""

# Operator runbook (one-time per environment):
#   1. Add the three vars above to Vercel → Settings → Environment Variables
#      (Production + Preview scopes).
#   2. Supabase Dashboard → Database → Replication → enable for table
#      `feedback` (singular — Prisma @@map("feedback"); publication:
#      supabase_realtime, default).
#   3. Supabase SQL Editor → run the RLS policy from
#      docs/supabase-realtime-setup.sql (committed alongside this PR).
#   4. Redeploy. ActivityFeed badge will switch from "Pasif" → "Canlı" on
#      next dashboard load.

# --- AI CO-PILOT (OpenAI) ---
# Used by /api/feedback/[id]/suggest-reply. When unset, the endpoint
# falls back to a deterministic template so the UI keeps working.
OPENAI_API_KEY=""
# Optional model override — defaults to gpt-4o-mini.
OPENAI_MODEL="gpt-4o-mini"

# --- FIREBASE (Google Sign-in) ---
# Web app config from Firebase console → Project settings → Your apps.
# Client-side; safe to expose. When ANY of the four are missing the
# "Continue with Google" button stays inactive and shows a notice.
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=""
NEXT_PUBLIC_FIREBASE_PROJECT_ID=""
NEXT_PUBLIC_FIREBASE_APP_ID=""
# Optional: set when NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN is your own domain.
# Defaults to <NEXT_PUBLIC_FIREBASE_PROJECT_ID>.firebaseapp.com and is used by
# Next rewrites for /__/auth/* so Google sign-in can stay on your domain.
FIREBASE_AUTH_PROXY_TARGET=""
# Optional override for server-side ID token verification. Defaults to
# NEXT_PUBLIC_FIREBASE_PROJECT_ID; set this only when admin verification
# should target a different project.
FIREBASE_ADMIN_PROJECT_ID=""

# --- reCAPTCHA ENTERPRISE ---
# Public site key used by grecaptcha.enterprise.execute().
NEXT_PUBLIC_RECAPTCHA_ENTERPRISE_SITE_KEY=""
# Server-side assessment call. Replace with your own GCP project id; can
# differ from Firebase if your reCAPTCHA Enterprise key lives elsewhere.
RECAPTCHA_ENTERPRISE_PROJECT_ID=""
# Optional server-side Google Cloud API key for CreateAssessment. If omitted,
# the server uses RECAPTCHA_ENTERPRISE_SERVICE_ACCOUNT_JSON / ADC.
RECAPTCHA_ENTERPRISE_API_KEY=""
# Vercel-friendly JSON payload for a service account that can call
# `projects.assessments.create` on the project above. Keep this server-only.
RECAPTCHA_ENTERPRISE_SERVICE_ACCOUNT_JSON='{"client_email":"","private_key":""}'
# Alternatively you can rely on GOOGLE_APPLICATION_CREDENTIALS / ADC.
# Optional score threshold. 0.5 is a balanced default for forms/login.
RECAPTCHA_ENTERPRISE_MIN_SCORE="0.5"
# Monitor mode: when "false" (default) reCAPTCHA failures are logged but
# DO NOT block the user — useful while you tune thresholds and confirm
# scores in the Google Cloud console. Flip to "true" once dashboards
# look healthy. Stripe Radar / Cloudflare Turnstile rollout pattern.
RECAPTCHA_ENFORCE="false"

# --- UPSTASH REDIS (distributed rate limiting) ---
# Used by `src/lib/rate-limit.ts` for Vercel-wide rate limit enforcement.
# Without these the limiter falls back to per-instance in-memory mode
# which is fine for local dev but provides only weak burst protection
# in production (each cold start gets a fresh process).
#
# Vercel Marketplace integration auto-provisions these as `KV_REST_*`.
# If you set up Upstash directly, the equivalent `UPSTASH_REDIS_REST_*`
# env vars are also accepted by the limiter.
KV_REST_API_URL=""
KV_REST_API_TOKEN=""
# Read-only token (not consumed by rate-limit yet, but provided by the
# Vercel integration; useful for future cache reads).
KV_REST_API_READ_ONLY_TOKEN=""

# --- SENTRY (error tracking + performance) ---
# Optional. Without DSN, instrumentation.ts is a no-op and
# next.config.ts skips withSentryConfig (no source-map upload, no
# extra build overhead). Recommended for production observability —
# without it, runtime errors are invisible until a customer reports.
#
# Free tier (5K events / 10K transactions per month) covers the project
# at current scale; upgrade only if volume crosses that threshold.
#
# Setup:
#   1. Create a Next.js project at https://sentry.io
#   2. Copy DSN into both SENTRY_DSN (server) and NEXT_PUBLIC_SENTRY_DSN (browser)
#   3. Auth token + org/project enable Vercel build source-map upload
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_ORG=""
SENTRY_PROJECT=""
# Auth token used during `next build` to upload source maps to Sentry.
# Create one at https://sentry.io/settings/account/api/auth-tokens/
# with `project:releases` scope.
SENTRY_AUTH_TOKEN=""

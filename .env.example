# Database (Supabase vs Vercel)
# Transaction pooler URL (Kısa ömürlü bağlantılar için - genelde port 6543)
DATABASE_URL="postgresql://postgres:password@db.supabase.co:6543/postgres?pgbouncer=true&connection_limit=1"
# Direct connection URL (Migration işlemleri için - genelde port 5432)
DIRECT_URL="postgresql://postgres:password@db.supabase.co:5432/postgres"

# Google Review
GOOGLE_REVIEW_URL="https://search.google.com/local/writereview?placeid=YOUR_PLACE_ID"

# SMTP Email
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"
SMTP_FROM="Mamma's Burger <noreply@mammasburger.com>"
NOTIFICATION_EMAIL="owner@mammasburger.com"

# Admin
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="change-this-password"
JWT_SECRET="your-jwt-secret-change-this"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_RESTAURANT_NAME="Mamma's Burger Ankara"

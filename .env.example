# --- DATABASE (Supabase) ---
# Pooling URL (Transaction Mode - Port 6543)
DATABASE_URL="postgres://postgres.xxxx:password@aws-1-us-east-1.pooler.supabase.com:6543/postgres?sslmode=require&pgbouncer=true"
# Direct URL (Session Mode - Port 5432)
DIRECT_URL="postgres://postgres.xxxx:password@aws-1-us-east-1.pooler.supabase.com:5432/postgres?sslmode=require"

# --- GOOGLE REVIEW ---
# Place ID for Mamma's Burger Ankara
GOOGLE_REVIEW_URL="https://search.google.com/local/writereview?placeid=YOUR_PLACE_ID"

# --- SMTP EMAIL (Gmail/Resend/Brevo) ---
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=465
SMTP_USER="mammasburger@gmail.com"
SMTP_PASS="your-app-password"
SMTP_FROM="Mamma's Burger <noreply@mammasburger.com>"
NOTIFICATION_EMAIL="owner@mammasburger.com"

# --- ADMIN AUTH ---
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="secure-password-here"
JWT_SECRET=replace_with_secure_random_string

# --- APP CONFIG ---
NEXT_PUBLIC_APP_URL="https://your-app.vercel.app"
NEXT_PUBLIC_RESTAURANT_NAME="Mamma's Burger Ankara"

# --- SUPABASE STORAGE (site logo/favicon/og uploads) ---
# Project URL (Supabase dashboard → Project Settings → API)
SUPABASE_URL="https://xxxx.supabase.co"
# Service role key — server-only, NEVER expose to client
SUPABASE_SERVICE_ROLE_KEY="eyJhbG..."
# Public bucket name (create in Supabase Dashboard → Storage)
SUPABASE_STORAGE_BUCKET="site-assets"

# --- AI CO-PILOT (OpenAI) ---
# Used by /api/feedback/[id]/suggest-reply. When unset, the endpoint
# falls back to a deterministic template so the UI keeps working.
OPENAI_API_KEY=""
# Optional model override — defaults to gpt-4o-mini.
OPENAI_MODEL="gpt-4o-mini"
